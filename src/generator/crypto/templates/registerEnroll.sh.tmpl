#!/usr/bin/env bash
set -euo pipefail

# This script is generated for organization: {{ .Org.Name }}
if [ -z "${ROOTDIR:-}" ]; then
  ROOTDIR=$(cd "$(dirname "$0")"/../../.. && pwd)
fi
. ${ROOTDIR}/scripts/utils.sh

# Ensure the generated binaries folder is in the path
export PATH="${ROOTDIR}/bin:${PATH}"

if [ -f "${ROOTDIR}/.env" ]; then
  . "${ROOTDIR}/.env"
fi

{{- $orgUpper := toUpper .Org.Name }}

function register_identity() {
  local id_name="$1"
  local id_secret="$2"
  local id_type="$3"
  local ca_name="$4"
  local cert_file="$5"

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Registering identity '${id_name}' (${id_type}) on ${ca_name}"
    println "${C_DIM}+ fabric-ca-client register --caname ${ca_name} --id.name ${id_name} --id.secret ${id_secret} --id.type ${id_type} --tls.certfiles ${cert_file}${C_RESET}"
  fi

  set +e
  local reg_output
  reg_output=$(fabric-ca-client register --caname "${ca_name}" --id.name "${id_name}" --id.secret "${id_secret}" --id.type "${id_type}" --tls.certfiles "${cert_file}" 2>&1)
  local reg_rc=$?
  set -e

  if [ $reg_rc -ne 0 ]; then
    if [[ "${reg_output}" =~ "already registered" ]]; then
      if [ "${VERBOSE:-false}" = "true" ]; then
        task_warnln "Identity '${id_name}' is already registered on ${ca_name}."
      fi
    else
      task_fail
      task_errorln "Failed to register ${id_name}: ${reg_output}"
      exit 1
    fi
  elif [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Registered ${id_name} (${id_type})"
  fi
}

function createOrg{{ add .OrgIndex 1 }}() {
  if [ "${VERBOSE:-false}" = "true" ]; then
    sectionln "Configuring Organization: {{ .Org.Name }} (Org{{ add .OrgIndex 1 }})"
  fi

  task_start "Enrolling identities and certificates for {{ .Org.Name }}"

  LOCAL_CA_DIR="${ROOTDIR}/organizations/{{ toLower .Org.Name }}/ca"
  mkdir -p "${LOCAL_CA_DIR}"
  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Fetching CA certificate from container ca.{{ .Org.Domain }}"
  fi
  run_verbose "${CONTAINER_CLI}" cp ca.{{ .Org.Domain }}:/etc/hyperledger/fabric-ca-server/ca-cert.pem "${LOCAL_CA_DIR}/ca-cert.pem"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "CA root certificate fetched"
  fi

  # For peers
  {{ if gt .Org.PeerCount 0 }}
  ORG_DIR="${ROOTDIR}/organizations/{{ toLower .Org.Name }}/identities/peer"
  mkdir -p "${ORG_DIR}"
  export FABRIC_CA_CLIENT_HOME="${ORG_DIR}"

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Enrolling CA admin for {{ .Org.Name }}"
  fi
  run_verbose fabric-ca-client enroll -u https://${{ $orgUpper }}_CA_ADMIN_USER:${{ $orgUpper }}_CA_ADMIN_PASSWORD@localhost:{{ calculateCAPort .OrgIndex 7054 }} --caname {{ .Org.CAName }} --tls.certfiles "${LOCAL_CA_DIR}/ca-cert.pem"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "CA admin enrolled"
  fi

  echo 'NodeOUs:
  Enable: true
  ClientOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: client
  PeerOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: peer
  AdminOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: admin
  OrdererOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: orderer' > "${ORG_DIR}/msp/config.yaml"

  # Copy CA certs
  mkdir -p "${ORG_DIR}/msp/tlscacerts"
  cp "${LOCAL_CA_DIR}/ca-cert.pem" "${ORG_DIR}/msp/tlscacerts/ca.crt"
  mkdir -p "${ORG_DIR}/tlsca"
  cp "${LOCAL_CA_DIR}/ca-cert.pem" "${ORG_DIR}/tlsca/tlsca.{{ .Org.Domain }}-cert.pem"
  mkdir -p "${ORG_DIR}/ca"
  cp "${LOCAL_CA_DIR}/ca-cert.pem" "${ORG_DIR}/ca/ca.{{ .Org.Domain }}-cert.pem"

  {{ range $j, $peer := until .Org.PeerCount }}
  register_identity "peer{{ $j }}" "peer{{ $j }}pw" "peer" "{{ $.Org.CAName }}" "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"
  {{ end }}

  register_identity "user1" "user1pw" "client" "{{ .Org.CAName }}" "${LOCAL_CA_DIR}/ca-cert.pem"
  register_identity "{{ toLower .Org.Name }}admin" "${{ $orgUpper }}_CA_ADMIN_CLIENT_PASSWORD" "admin" "{{ .Org.CAName }}" "${LOCAL_CA_DIR}/ca-cert.pem"

  {{ range $j, $peer := until .Org.PeerCount }}
  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Generating MSP and TLS certificates for peer{{ $j }} ({{ $.Org.Name }})"
  fi
  PEER_DIR="${ORG_DIR}/peers/peer{{ $j }}.{{ $.Org.Domain }}"
  mkdir -p "${PEER_DIR}"
  run_verbose fabric-ca-client enroll -u https://peer{{ $j }}:peer{{ $j }}pw@localhost:{{ calculateCAPort $.OrgIndex 7054 }} --caname {{ $.Org.CAName }} -M "${PEER_DIR}/msp" --tls.certfiles "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"

  cp "${ORG_DIR}/msp/config.yaml" "${PEER_DIR}/msp/config.yaml"

  run_verbose fabric-ca-client enroll -u https://peer{{ $j }}:peer{{ $j }}pw@localhost:{{ calculateCAPort $.OrgIndex 7054 }} --caname {{ $.Org.CAName }} -M "${PEER_DIR}/tls" --enrollment.profile tls --csr.hosts peer{{ $j }}.{{ $.Org.Domain }} --csr.hosts localhost --tls.certfiles "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"

  # Copy the tls CA cert, server cert, server keystore to well known file names
  cp "${PEER_DIR}/tls/tlscacerts/"* "${PEER_DIR}/tls/ca.crt"
  cp "${PEER_DIR}/tls/signcerts/"* "${PEER_DIR}/tls/server.crt"
  cp "${PEER_DIR}/tls/keystore/"* "${PEER_DIR}/tls/server.key"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "peer{{ $j }} certificates generated"
  fi
  {{ end }}

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Generating User1 MSP for {{ .Org.Name }}"
  fi
  run_verbose fabric-ca-client enroll -u https://user1:user1pw@localhost:{{ calculateCAPort .OrgIndex 7054 }} --caname {{ .Org.CAName }} -M "${ORG_DIR}/users/User1@{{ .Org.Domain }}/msp" --tls.certfiles "${LOCAL_CA_DIR}/ca-cert.pem"
  cp "${ORG_DIR}/msp/config.yaml" "${ORG_DIR}/users/User1@{{ .Org.Domain }}/msp/config.yaml"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "User1 MSP generated"
  fi

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Generating Org Admin MSP for {{ .Org.Name }}"
  fi
  run_verbose fabric-ca-client enroll -u https://{{ toLower .Org.Name }}admin:${{ $orgUpper }}_CA_ADMIN_CLIENT_PASSWORD@localhost:{{ calculateCAPort .OrgIndex 7054 }} --caname {{ .Org.CAName }} -M "${ORG_DIR}/users/Admin@{{ .Org.Domain }}/msp" --tls.certfiles "${LOCAL_CA_DIR}/ca-cert.pem"
  cp "${ORG_DIR}/msp/config.yaml" "${ORG_DIR}/users/Admin@{{ .Org.Domain }}/msp/config.yaml"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Org Admin MSP generated"
  fi
  {{ end }}

  # For orderers
  {{ if gt .Org.OrdererCount 0 }}
  ORDERER_ORG_DIR="${ROOTDIR}/organizations/{{ toLower .Org.Name }}/identities/orderer"
  mkdir -p "${ORDERER_ORG_DIR}"
  export FABRIC_CA_CLIENT_HOME="${ORDERER_ORG_DIR}"

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Enrolling CA admin for {{ .Org.Name }} Orderers"
  fi
  run_verbose fabric-ca-client enroll -u https://${{ $orgUpper }}_CA_ADMIN_USER:${{ $orgUpper }}_CA_ADMIN_PASSWORD@localhost:{{ calculateCAPort .OrgIndex 7054 }} --caname {{ .Org.CAName }} --tls.certfiles "${LOCAL_CA_DIR}/ca-cert.pem"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Orderer CA admin enrolled"
  fi

  echo 'NodeOUs:
  Enable: true
  ClientOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: client
  PeerOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: peer
  AdminOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: admin
  OrdererOUIdentifier:
    Certificate: cacerts/localhost-{{ calculateCAPort .OrgIndex 7054 }}-{{ .Org.CAName }}.pem
    OrganizationalUnitIdentifier: orderer' > "${ORDERER_ORG_DIR}/msp/config.yaml"

  # Copy CA certs
  mkdir -p "${ORDERER_ORG_DIR}/msp/tlscacerts"
  cp "${LOCAL_CA_DIR}/ca-cert.pem" "${ORDERER_ORG_DIR}/msp/tlscacerts/ca.crt"
  mkdir -p "${ORDERER_ORG_DIR}/tlsca"
  cp "${LOCAL_CA_DIR}/ca-cert.pem" "${ORDERER_ORG_DIR}/tlsca/tlsca.{{ .Org.Domain }}-cert.pem"

  {{ range $j, $orderer := until .Org.OrdererCount }}
  register_identity "orderer{{ $j }}" "orderer{{ $j }}pw" "orderer" "{{ $.Org.CAName }}" "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Generating MSP and TLS certificates for orderer{{ $j }} ({{ $.Org.Name }})"
  fi
  ORDERER_DIR="${ORDERER_ORG_DIR}/orderers/orderer{{ $j }}.{{ $.Org.Domain }}"
  mkdir -p "${ORDERER_DIR}"
  run_verbose fabric-ca-client enroll -u https://orderer{{ $j }}:orderer{{ $j }}pw@localhost:{{ calculateCAPort $.OrgIndex 7054 }} --caname {{ $.Org.CAName }} -M "${ORDERER_DIR}/msp" --tls.certfiles "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"

  cp "${ORDERER_ORG_DIR}/msp/config.yaml" "${ORDERER_DIR}/msp/config.yaml"

  run_verbose fabric-ca-client enroll -u https://orderer{{ $j }}:orderer{{ $j }}pw@localhost:{{ calculateCAPort $.OrgIndex 7054 }} --caname {{ $.Org.CAName }} -M "${ORDERER_DIR}/tls" --enrollment.profile tls --csr.hosts orderer{{ $j }}.{{ $.Org.Domain }} --csr.hosts localhost --tls.certfiles "${ROOTDIR}/organizations/{{ toLower $.Org.Name }}/ca/ca-cert.pem"

  # Copy the tls CA cert, server cert, server keystore to well known file names
  cp "${ORDERER_DIR}/tls/tlscacerts/"* "${ORDERER_DIR}/tls/ca.crt"
  cp "${ORDERER_DIR}/tls/signcerts/"* "${ORDERER_DIR}/tls/server.crt"
  cp "${ORDERER_DIR}/tls/keystore/"* "${ORDERER_DIR}/tls/server.key"

  # Copy orderer org's CA cert to orderer's /msp/tlscacerts directory
  mkdir -p "${ORDERER_DIR}/msp/tlscacerts"
  cp "${ORDERER_DIR}/tls/tlscacerts/"* "${ORDERER_DIR}/msp/tlscacerts/tlsca.{{ $.Org.Domain }}-cert.pem"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "orderer{{ $j }} certificates generated"
  fi
  {{ end }}

  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Generating Orderer Admin MSP for {{ .Org.Name }}"
  fi
  run_verbose fabric-ca-client enroll -u https://{{ toLower .Org.Name }}admin:${{ $orgUpper }}_CA_ADMIN_CLIENT_PASSWORD@localhost:{{ calculateCAPort .OrgIndex 7054 }} --caname {{ .Org.CAName }} -M "${ORDERER_ORG_DIR}/users/Admin@{{ .Org.Domain }}/msp" --tls.certfiles "${LOCAL_CA_DIR}/ca-cert.pem"
  cp "${ORDERER_ORG_DIR}/msp/config.yaml" "${ORDERER_ORG_DIR}/users/Admin@{{ .Org.Domain }}/msp/config.yaml"
  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Orderer Admin MSP generated"
  fi
  {{ end }}

  if [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Organization {{ .Org.Name }} identities and certificates configured"
  else
    task_done
  fi
}

createOrg{{ add .OrgIndex 1 }}
