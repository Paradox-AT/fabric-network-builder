#!/usr/bin/env bash
set -euo pipefail

# This script dynamically adds a new organization to a running channel.
# It is generated by Hyperledger Fabric Network Builder.

ROOTDIR=$(cd "$(dirname "$0")"/../ && pwd)
. "${ROOTDIR}/scripts/utils.sh"
. "${ROOTDIR}/scripts/envVar.sh"
. "${ROOTDIR}/network.config"

# Source .env to get CA credentials
if [ -f "${ROOTDIR}/.env" ]; then
  set -a
  . "${ROOTDIR}/.env"
  set +a
fi

export FABRIC_CFG_PATH_PEER="${ROOTDIR}/config"
export FABRIC_CFG_PATH_ORDERER="${ROOTDIR}/configtx"

ORG_NAME="${1:-}"
CHANNEL_NAME="${2:-${CHANNEL_NAME}}"

if [ -z "${ORG_NAME}" ]; then
  fatalln "Please specify the organization name to add. Usage: ./network.sh addOrg -org <OrgName> -c <ChannelName>"
fi

# Resolve organization index and validation
ORG_INDEX=$(getOrgIndex "${ORG_NAME}")
ORG_NAME_CORRECT=$(getOrgName "${ORG_INDEX}")
ORG_DIR=$(getOrgDir "${ORG_INDEX}")
ORG_DOMAIN=$(getOrgDomain "${ORG_INDEX}")

headerln "Onboarding Organization: ${ORG_NAME_CORRECT} (${ORG_DOMAIN}) to Channel '${CHANNEL_NAME}'"

# ----------------------------------------------------------------------
# 1. Generate Crypto Material for New Org (if not already existing)
# ----------------------------------------------------------------------
sectionln "1. Generating Crypto Material for ${ORG_NAME_CORRECT}"

if [ "${CRYPTO}" == "Fabric CA" ]; then
  CA_EXISTS=true
  if [ ! -f "${ROOTDIR}/organizations/${ORG_DIR}/ca/ca-cert.pem" ]; then
    CA_EXISTS=false
  fi

  if [ "${CA_EXISTS}" = "false" ]; then
    task_start "Starting Certificate Authority for ${ORG_NAME_CORRECT}"
    {{- range $i, $org := .Orgs }}
    if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
      {{- if eq $.CADatabaseType "postgres" }}
      run_verbose container_compose -f ${ROOTDIR}/compose/compose-cas.yaml up -d "db.ca.{{ .Domain }}" "ca.{{ .Domain }}"
      {{- else }}
      run_verbose container_compose -f ${ROOTDIR}/compose/compose-cas.yaml up -d "ca.{{ .Domain }}"
      {{- end }}
    fi
    {{- end }}

    mkdir -p "${ROOTDIR}/organizations/${ORG_DIR}/ca"

    COUNTER=0
    while [ $COUNTER -lt 10 ]; do
      "${CONTAINER_CLI}" cp ca.${ORG_DOMAIN}:/etc/hyperledger/fabric-ca-server/ca-cert.pem "${ROOTDIR}/organizations/${ORG_DIR}/ca/ca-cert.pem" >/dev/null 2>&1 && break
      sleep 1
      COUNTER=$((COUNTER + 1))
    done

    export FABRIC_CA_CLIENT_HOME="${ROOTDIR}/organizations/${ORG_DIR}/identities/peer/${ORG_DOMAIN}"
    mkdir -p "${FABRIC_CA_CLIENT_HOME}"

    ORG_UPPER=$(echo "${ORG_NAME_CORRECT}" | tr '[:lower:]' '[:upper:]')
    CA_ADMIN_USER_VAR="${ORG_UPPER}_CA_ADMIN_USER"
    CA_ADMIN_PASSWORD_VAR="${ORG_UPPER}_CA_ADMIN_PASSWORD"
    CA_ADMIN_USER="${!CA_ADMIN_USER_VAR}"
    CA_ADMIN_PASSWORD="${!CA_ADMIN_PASSWORD_VAR}"
    CA_PORT=$(( (ORG_INDEX * 10000) + 2000 + 54 ))

    COUNTER=0
    while [ $COUNTER -lt 20 ]; do
      sleep 1
      if fabric-ca-client getcainfo -u https://${CA_ADMIN_USER}:${CA_ADMIN_PASSWORD}@localhost:${CA_PORT} --caname ${ORG_NAME_CORRECT}CA --tls.certfiles "${ROOTDIR}/organizations/${ORG_DIR}/ca/ca-cert.pem" >/dev/null 2>&1; then
        break
      fi
      COUNTER=$((COUNTER + 1))
    done
    task_done
  fi

  msp_exists=false
  {{- range $i, $org := .Orgs }}
  if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
    {{- if gt .PeerCount 0 }}
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/peer/msp" ]; then
      msp_exists=true
    fi
    {{- else }}
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/msp" ]; then
      msp_exists=true
    fi
    {{- end }}
  fi
  {{- end }}

  if [ "${msp_exists}" = "false" ]; then
    . ${ROOTDIR}/organizations/${ORG_DIR}/scripts/registerEnroll.sh
    # Restore ORG_DIR to its correct value since registerEnroll.sh pollutes it
    ORG_DIR=$(getOrgDir "${ORG_INDEX}")
  else
    task_start "Enrolling identities and certificates for ${ORG_NAME_CORRECT}"
    task_done "already exists"
  fi
else
  # Using cryptogen
  crypto_exists=false
  {{- range $i, $org := .Orgs }}
  if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
    {{- if gt .PeerCount 0 }}
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/peer/msp" ]; then
      crypto_exists=true
    fi
    {{- else }}
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/msp" ]; then
      crypto_exists=true
    fi
    {{- end }}
  fi
  {{- end }}

  if [ "${crypto_exists}" = "false" ]; then
    task_start "Generating crypto material for ${ORG_NAME_CORRECT} using cryptogen"
    run_verbose cryptogen generate --config=${ROOTDIR}/organizations/${ORG_DIR}/identity-config/cryptogen/crypto-config.yaml --output="${ROOTDIR}/organizations/${ORG_DIR}/identities" || { task_fail; fatalln "Cryptogen generation failed"; }

    # Flatten cryptogen output
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/peerOrganizations" ]; then
      mkdir -p ${ROOTDIR}/organizations/${ORG_DIR}/identities/peer
      mv ${ROOTDIR}/organizations/${ORG_DIR}/identities/peerOrganizations/${ORG_DOMAIN}/* ${ROOTDIR}/organizations/${ORG_DIR}/identities/peer/ 2>/dev/null || true
      rm -rf ${ROOTDIR}/organizations/${ORG_DIR}/identities/peerOrganizations
      find ${ROOTDIR}/organizations/${ORG_DIR}/identities/peer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
    fi
    if [ -d "${ROOTDIR}/organizations/${ORG_DIR}/identities/ordererOrganizations" ]; then
      mkdir -p ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer
      mv ${ROOTDIR}/organizations/${ORG_DIR}/identities/ordererOrganizations/${ORG_DOMAIN}/* ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/ 2>/dev/null || true
      rm -rf ${ROOTDIR}/organizations/${ORG_DIR}/identities/ordererOrganizations
      find ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
    fi
    task_done
  else
    task_start "Generating crypto material for ${ORG_NAME_CORRECT} using cryptogen"
    task_done "already exists"
  fi
fi

# Generate Client Connection Profile for the new organization
if [ -f "${ROOTDIR}/organizations/ccp-generate.sh" ] && verifyPeerOrg "${ORG_INDEX}"; then
  task_start "Generating Client Connection Profile for ${ORG_NAME_CORRECT}"
  "${ROOTDIR}/organizations/ccp-generate.sh" "${ORG_INDEX}" "true"
  task_done
fi

# ----------------------------------------------------------------------
# 2. Export Org Definition JSON
# ----------------------------------------------------------------------
sectionln "2. Exporting Organization Definition"
task_start "Exporting organization definition JSON for ${ORG_NAME_CORRECT}"
mkdir -p "${ROOTDIR}/channel-artifacts"
run_verbose bash -c "FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} configtxgen -printOrg ${ORG_NAME_CORRECT} > ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}.json" || { task_fail; fatalln "configtxgen printOrg failed"; }
task_done

# ----------------------------------------------------------------------
# 3. Channel Configuration Update
# ----------------------------------------------------------------------
sectionln "3. Updating Channel Configuration"
{{- $foundFirstOrg := false }}
{{- $firstOrgIndex := 1 }}
{{- range $i, $org := .Orgs }}
  {{- if and (gt .PeerCount 0) (not $foundFirstOrg) }}
    {{- $firstOrgIndex = inc $i }}
    {{- $foundFirstOrg = true }}
  {{- end }}
{{- end }}

ESTABLISHED_ORG_INDEX={{ $firstOrgIndex }}
export FABRIC_CFG_PATH="${FABRIC_CFG_PATH_PEER}"
setGlobals ${ESTABLISHED_ORG_INDEX}

task_start "Fetching and decoding channel configuration block"
run_verbose peer channel fetch config ${ROOTDIR}/channel-artifacts/config_block.pb -o ${ORDERER_ADDRESS} -c ${CHANNEL_NAME} --tls --cafile ${ORDERER_CA} || { task_fail; fatalln "Fetch config block failed"; }
run_verbose configtxlator proto_decode --input ${ROOTDIR}/channel-artifacts/config_block.pb --type common.Block --output ${ROOTDIR}/channel-artifacts/config_block.json || { task_fail; fatalln "Decode config block failed"; }
jq .data.data[0].payload.data.config ${ROOTDIR}/channel-artifacts/config_block.json > ${ROOTDIR}/channel-artifacts/config.json
task_done

setGlobals ${ORG_INDEX}
NEW_ORG_MSPID="${CORE_PEER_LOCALMSPID}"
setGlobals ${ESTABLISHED_ORG_INDEX}

# Start config update operations
cp ${ROOTDIR}/channel-artifacts/config.json ${ROOTDIR}/channel-artifacts/working_config.json

# If new org has peers, add to Application group
HAS_PEERS=false
{{- range $i, $org := .Orgs }}
{{- if gt .PeerCount 0 }}
if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
  HAS_PEERS=true
fi
{{- end }}
{{- end }}

if [ "${HAS_PEERS}" = "true" ]; then
  task_start "Injecting ${ORG_NAME_CORRECT} into Application group"
  jq 'del(.values.Endpoints)' ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}.json > ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}_app.json
  jq -s ".[0] * {\"channel_group\":{\"groups\":{\"Application\":{\"groups\":{\"${NEW_ORG_MSPID}\":.[1]}}}}}" ${ROOTDIR}/channel-artifacts/working_config.json ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}_app.json > ${ROOTDIR}/channel-artifacts/next_config.json
  mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json
  task_done
fi

# If new org has orderers, add to Orderer group and configure consensus
HAS_ORDERERS=false
{{- range $i, $org := .Orgs }}
{{- if gt .OrdererCount 0 }}
if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
  HAS_ORDERERS=true
fi
{{- end }}
{{- end }}

if [ "${HAS_ORDERERS}" = "true" ]; then
  task_start "Injecting ${ORG_NAME_CORRECT} into Orderer group"
  jq 'del(.values.AnchorPeers)' ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}.json > ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}_ord.json
  jq -s ".[0] * {\"channel_group\":{\"groups\":{\"Orderer\":{\"groups\":{\"${NEW_ORG_MSPID}\":.[1]}}}}}" ${ROOTDIR}/channel-artifacts/working_config.json ${ROOTDIR}/channel-artifacts/${ORG_NAME_CORRECT}_ord.json > ${ROOTDIR}/channel-artifacts/next_config.json
  mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json

  CONSENSUS_TYPE=$(jq -r '.channel_group.groups.Orderer.values.ConsensusType.value.type' ${ROOTDIR}/channel-artifacts/working_config.json)

  {{- range $i, $org := .Orgs }}
  {{- if gt .OrdererCount 0 }}
  if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
    {{- range $j, $orderer := until .OrdererCount }}
    CLIENT_TLS_CERT=$(cat ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.crt | base64 | tr -d '\n')
    SERVER_TLS_CERT=$(cat ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.crt | base64 | tr -d '\n')

    if [ "${CONSENSUS_TYPE}" = "etcdraft" ]; then
      jq ".channel_group.values.OrdererAddresses.value.addresses += [\"orderer{{$j}}.${ORG_DOMAIN}:7050\"]" ${ROOTDIR}/channel-artifacts/working_config.json > ${ROOTDIR}/channel-artifacts/next_config.json
      mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json

      NEW_CONSER=$(jq -n \
        --arg host "orderer{{$j}}.${ORG_DOMAIN}" \
        --arg port 7050 \
        --arg client_cert "${CLIENT_TLS_CERT}" \
        --arg server_cert "${SERVER_TLS_CERT}" \
        '{client_tls_cert: $client_cert, server_tls_cert: $server_cert, host: $host, port: ($port | tonumber)}')

      jq ".channel_group.groups.Orderer.values.ConsensusType.value.metadata.consenters += [$NEW_CONSER]" ${ROOTDIR}/channel-artifacts/working_config.json > ${ROOTDIR}/channel-artifacts/next_config.json
      mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json
    elif [ "${CONSENSUS_TYPE}" = "BFT" ]; then
      IDENTITY_CERT=$(cat ${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/msp/signcerts/cert.pem | base64 | tr -d '\n')
      NEXT_ID=$(jq '.channel_group.groups.Orderer.values.Orderers.value.consenter_mapping | length + 1' ${ROOTDIR}/channel-artifacts/working_config.json)

      NEW_CONSER=$(jq -n \
        --argjson id "${NEXT_ID}" \
        --arg host "orderer{{$j}}.${ORG_DOMAIN}" \
        --arg port 7050 \
        --arg msp "${NEW_ORG_MSPID}" \
        --arg identity "${IDENTITY_CERT}" \
        --arg client_cert "${CLIENT_TLS_CERT}" \
        --arg server_cert "${SERVER_TLS_CERT}" \
        '{id: $id, host: $host, port: ($port | tonumber), msp_id: $msp, identity: $identity, client_tls_cert: $client_cert, server_tls_cert: $server_cert}')

      jq ".channel_group.groups.Orderer.values.Orderers.value.consenter_mapping += [$NEW_CONSER]" ${ROOTDIR}/channel-artifacts/working_config.json > ${ROOTDIR}/channel-artifacts/next_config.json
      mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json
    fi
    {{- end }}
  fi
  {{- end }}
  {{- end }}
  task_done
fi

if [ "${HAS_ORDERERS}" = "true" ] && [ "${CONSENSUS_TYPE}" = "BFT" ]; then
  task_start "Updating BFT BlockValidation policy based on updated consenters"
  jq '
    .channel_group.groups.Orderer.values.Orderers.value.consenter_mapping as $consenters |
    ($consenters | length) as $N |
    (($N - 1) / 3 | floor) as $f |
    ($N - $f) as $n |
    ($consenters | map({
      "principal": {
        "id_bytes": .identity,
        "mspid": .msp_id
      },
      "principal_classification": "IDENTITY"
    })) as $identities |
    ($consenters | keys | map({"signed_by": .})) as $rules |
    .channel_group.groups.Orderer.policies.BlockValidation.policy.value = {
      "identities": $identities,
      "rule": {
        "n_out_of": {
          "n": $n,
          "rules": $rules
        }
      },
      "version": 0
    }
  ' ${ROOTDIR}/channel-artifacts/working_config.json > ${ROOTDIR}/channel-artifacts/next_config.json
  mv ${ROOTDIR}/channel-artifacts/next_config.json ${ROOTDIR}/channel-artifacts/working_config.json
  task_done
fi

cp ${ROOTDIR}/channel-artifacts/working_config.json ${ROOTDIR}/channel-artifacts/modified_config.json

task_start "Computing and encoding channel configuration update"
run_verbose configtxlator proto_encode --input ${ROOTDIR}/channel-artifacts/config.json --type common.Config --output ${ROOTDIR}/channel-artifacts/config.pb || { task_fail; fatalln "Proto encode config.json failed"; }
run_verbose configtxlator proto_encode --input ${ROOTDIR}/channel-artifacts/modified_config.json --type common.Config --output ${ROOTDIR}/channel-artifacts/modified_config.pb || { task_fail; fatalln "Proto encode modified_config.json failed"; }
run_verbose configtxlator compute_update --channel_id ${CHANNEL_NAME} --original ${ROOTDIR}/channel-artifacts/config.pb --updated ${ROOTDIR}/channel-artifacts/modified_config.pb --output ${ROOTDIR}/channel-artifacts/config_update.pb || { task_fail; fatalln "Compute update failed"; }
run_verbose configtxlator proto_decode --input ${ROOTDIR}/channel-artifacts/config_update.pb --type common.ConfigUpdate --output ${ROOTDIR}/channel-artifacts/config_update.json || { task_fail; fatalln "Proto decode config_update failed"; }
echo "{\"payload\":{\"header\":{\"channel_header\":{\"channel_id\":\"${CHANNEL_NAME}\", \"type\":2}},\"data\":{\"config_update\":$(cat ${ROOTDIR}/channel-artifacts/config_update.json)}}}" | jq . > ${ROOTDIR}/channel-artifacts/config_update_in_envelope.json
run_verbose configtxlator proto_encode --input ${ROOTDIR}/channel-artifacts/config_update_in_envelope.json --type common.Envelope --output ${ROOTDIR}/channel-artifacts/config_update_in_envelope.pb || { task_fail; fatalln "Proto encode envelope failed"; }
task_done

# Sign with all other existing organizations
task_start "Signing channel configuration update with existing organizations"
{{- range $i, $org := .Orgs }}
  {{- if and (or (gt .PeerCount 0) (gt .OrdererCount 0)) (ne (inc $i) $firstOrgIndex) }}
if [ "${ORG_INDEX}" -ne {{ inc $i }} ]; then
  setGlobals {{ inc $i }}
  run_verbose peer channel signconfigtx -f ${ROOTDIR}/channel-artifacts/config_update_in_envelope.pb || { task_fail; fatalln "Signing by {{ .Name }} failed"; }
fi
  {{- end }}
{{- end }}
task_done

task_start "Submitting channel configuration update transaction"
setGlobals ${ESTABLISHED_ORG_INDEX}
run_verbose peer channel update -f ${ROOTDIR}/channel-artifacts/config_update_in_envelope.pb -c ${CHANNEL_NAME} -o ${ORDERER_ADDRESS} --tls --cafile ${ORDERER_CA} || { task_fail; fatalln "Peer channel update failed"; }
task_done

# ----------------------------------------------------------------------
# 4. Launch Infrastructure
# ----------------------------------------------------------------------
sectionln "4. Starting Docker Containers for ${ORG_NAME_CORRECT}"
task_start "Starting peer and orderer containers"
run_verbose container_compose -f ${ROOTDIR}/compose/docker-compose.yaml up -d || { task_fail; fatalln "Starting containers failed"; }
task_done

# ----------------------------------------------------------------------
# 5. Join Channel
# ----------------------------------------------------------------------
sectionln "5. Joining Channel '${CHANNEL_NAME}'"
task_start "Fetching channel genesis block"
setGlobals ${ESTABLISHED_ORG_INDEX}
run_verbose peer channel fetch 0 ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block -o ${ORDERER_ADDRESS} -c ${CHANNEL_NAME} --tls --cafile ${ORDERER_CA} || { task_fail; fatalln "Fetch channel block failed"; }
task_done

# Join peers
if [ "${HAS_PEERS}" = "true" ]; then
  task_start "Joining peers of ${ORG_NAME_CORRECT} to channel '${CHANNEL_NAME}'"
  {{- range $i, $org := .Orgs }}
  {{- if gt .PeerCount 0 }}
  if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
    {{- range $j, $p := until .PeerCount }}
    setGlobals ${ORG_INDEX} {{ $j }}
    if ! peer channel list 2>/dev/null | grep -q "^${CHANNEL_NAME}$"; then
      run_verbose peer channel join -b ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block || { task_fail; fatalln "Peer{{ $j }} join failed"; }
    fi
    {{- end }}
  fi
  {{- end }}
  {{- end }}
  task_done
fi

# Join orderers using osnadmin
if [ "${HAS_ORDERERS}" = "true" ]; then
  task_start "Joining orderers of ${ORG_NAME_CORRECT} to channel '${CHANNEL_NAME}'"
  {{- range $i, $org := .Orgs }}
  {{- if gt .OrdererCount 0 }}
  if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
    {{- range $j, $orderer := until .OrdererCount }}
    if ! osnadmin channel list \
      -o localhost:{{ calculateOrdererPort $i $j 7053 }} \
      --ca-file "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/tlsca/tlsca.${ORG_DOMAIN}-cert.pem" \
      --client-cert "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.crt" \
      --client-key "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.key" \
      2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
      run_verbose osnadmin channel join \
        --channelID ${CHANNEL_NAME} \
        --config-block ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block \
        -o localhost:{{ calculateOrdererPort $i $j 7053 }} \
        --ca-file "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/tlsca/tlsca.${ORG_DOMAIN}-cert.pem" \
        --client-cert "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.crt" \
        --client-key "${ROOTDIR}/organizations/${ORG_DIR}/identities/orderer/orderers/orderer{{$j}}.${ORG_DOMAIN}/tls/server.key" || { task_fail; fatalln "Orderer{{ $j }} join failed"; }
    fi
    {{- end }}
  fi
  {{- end }}
  {{- end }}
  task_done
fi

# ----------------------------------------------------------------------
# 6. Chaincode Onboarding
# ----------------------------------------------------------------------
if [ "${HAS_PEERS}" = "true" ]; then
  sectionln "6. Onboarding Existing Chaincodes"
  setGlobals ${ESTABLISHED_ORG_INDEX}
  COMMITTED_CCS=$(peer lifecycle chaincode querycommitted -C ${CHANNEL_NAME} -o ${ORDERER_ADDRESS} --tls --cafile ${ORDERER_CA} --output json 2>/dev/null || true)

  if [ -n "${COMMITTED_CCS}" ] && [ "${COMMITTED_CCS}" != "null" ]; then
    echo "${COMMITTED_CCS}" | jq -c '.chaincode_definitions[]' | while read -r cc; do
      CC_NAME=$(echo "$cc" | jq -r '.name')
      CC_VERSION=$(echo "$cc" | jq -r '.version')
      CC_SEQUENCE=$(echo "$cc" | jq -r '.sequence')

      PKG_PATH="${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz"
      if [ -f "${PKG_PATH}" ]; then
        task_start "Onboarding chaincode ${CC_NAME} (v${CC_VERSION}, seq ${CC_SEQUENCE}) for ${ORG_NAME_CORRECT}"
        export FABRIC_CFG_PATH="${FABRIC_CFG_PATH_PEER}"
        PKG_ID=$(peer lifecycle chaincode calculatepackageid "${PKG_PATH}" 2>/dev/null || true)

        {{- range $i, $org := .Orgs }}
        {{- if gt .PeerCount 0 }}
        if [ "${ORG_INDEX}" -eq {{ inc $i }} ]; then
          {{- range $j, $p := until .PeerCount }}
          setGlobals ${ORG_INDEX} {{ $j }}
          if ! peer lifecycle chaincode queryinstalled --output json 2>/dev/null | jq -r 'try (.installed_chaincodes[].package_id)' | grep -q "^${PKG_ID}$"; then
            run_verbose peer lifecycle chaincode install "${PKG_PATH}" || { task_fail; fatalln "Install failed on peer{{ $j }}"; }
          fi
          {{- end }}
        fi
        {{- end }}
        {{- end }}

        if [ -n "${PKG_ID}" ]; then
          setGlobals ${ORG_INDEX}
          INIT_REQUIRED=""
          if [ "$(echo "$cc" | jq -r '.init_required // empty')" = "true" ]; then
            INIT_REQUIRED="--init-required"
          fi

          run_verbose peer lifecycle chaincode approveformyorg -o "${ORDERER_ADDRESS}" --tls --cafile "${ORDERER_CA}" --channelID "${CHANNEL_NAME}" --name "${CC_NAME}" --version "${CC_VERSION}" --package-id "${PKG_ID}" --sequence "${CC_SEQUENCE}" ${INIT_REQUIRED} || { task_fail; fatalln "Approve failed"; }
        fi
        task_done
      else
        warnln "Packaged chaincode not found at ${PKG_PATH}. Skipping chaincode onboarding."
      fi
    done
  fi
fi

successln "Organization ${ORG_NAME_CORRECT} successfully onboarded to '${CHANNEL_NAME}'."
