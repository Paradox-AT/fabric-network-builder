#!/usr/bin/env bash
set -euo pipefail

# This script bootstraps the Hyperledger Fabric binaries and docker images
# based on the configuration selected in the Network Builder.

ROOTDIR=$(cd "$(dirname "$0")"/../ && pwd)
. "${ROOTDIR}/network.config"
export CONTAINER_CLI=${CONTAINER_CLI:-docker}

# Detect OS and Architecture
OS_NAME=$(uname -s | tr '[:upper:]' '[:lower:]')
case "${OS_NAME}" in
  darwin)
    OS_NAME=darwin
    ;;
  linux)
    OS_NAME=linux
    ;;
  *)
    echo "Unknown, unsupported OS: ${OS_NAME}"
    exit 1
    ;;
esac

ARCH=$(uname -m)
case "${ARCH}" in
  x86_64)
    ARCH=amd64
    ;;
  aarch64 | arm64)
    ARCH=arm64
    ;;
  *)
    echo "Unknown, unsupported architecture: ${ARCH}"
    exit 1
    ;;
esac

echo "=== Detected Platform: ${OS_NAME}-${ARCH} ==="

# Registry detection logic from official install-fabric.sh
dockerFabricRegistry() {
  local version=${1:-}
  # Remove trailing pre-release or metadata identifiers
  version="${version%%[-+]*}"
  case "${version}" in
    1.*|2.[0-4].*|2.5.[0-9]|2.5.10|3.0.0)
      echo -n "docker.io/hyperledger"
      ;;
    *)
      echo -n "ghcr.io/hyperledger"
      ;;
  esac
}

dockerCARegistry() {
  local version=${1:-}
  version="${version%%[-+]*}"
  case "${version}" in
    1.[0-4].*|1.5.[0-9]|1.5.1[0-4])
      echo -n "docker.io/hyperledger"
      ;;
    *)
      echo -n "ghcr.io/hyperledger"
      ;;
  esac
}

# Prior to fabric 2.5, use amd64 binaries on darwin-arm64
if [ "${OS_NAME}" == "darwin" ] && [ "${ARCH}" == "arm64" ]; then
  if [[ ${FABRIC_VERSION} =~ ^2\.[0-4]\.* ]]; then
    echo "==> Falling back to amd64 binaries for Fabric ${FABRIC_VERSION} on Darwin ARM64"
    ARCH=amd64
  fi
fi

PLATFORM=${OS_NAME}-${ARCH}

download() {
  local LABEL=${1:-}
  local URL=${2:-}
  local FILE=${3:-}

  if [ -f "${FILE}" ]; then
    echo "==> ${LABEL} already downloaded."
  else
    echo "==> Downloading ${LABEL}..."
    curl -L --retry 5 --retry-delay 3 "${URL}" -o "${FILE}" || { echo "Error downloading ${URL}"; exit 1; }
  fi
}

# 1. Download and extract binaries
BINARY_FILE="${ROOTDIR}/hyperledger-fabric-${PLATFORM}-${FABRIC_VERSION}.tar.gz"
BINARY_URL="https://github.com/hyperledger/fabric/releases/download/v${FABRIC_VERSION}/hyperledger-fabric-${PLATFORM}-${FABRIC_VERSION}.tar.gz"

NEED_FABRIC=true
if [ -f "${ROOTDIR}/bin/peer" ]; then
  CURRENT_VER=$("${ROOTDIR}/bin/peer" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
  if [ "${CURRENT_VER}" == "${FABRIC_VERSION}" ]; then
    echo "==> Fabric binaries (v${CURRENT_VER}) already exist. Skipping download."
    NEED_FABRIC=false
  else
    echo "==> Version mismatch: found v${CURRENT_VER}, need v${FABRIC_VERSION}."
  fi
fi

if [ "$NEED_FABRIC" == "true" ]; then
  while true; do
    download "Fabric Binaries" "${BINARY_URL}" "${BINARY_FILE}"
    echo "==> Verifying SHA256 checksum for Fabric binaries via GitHub Releases API..."
    DIGEST=$(curl -sL "https://api.github.com/repos/hyperledger/fabric/releases/tags/v${FABRIC_VERSION}" \
      | jq -r --arg name "hyperledger-fabric-${PLATFORM}-${FABRIC_VERSION}.tar.gz" \
        '.assets[] | select(.name == $name) | .digest' 2>/dev/null || true)

    if [ -n "${DIGEST}" ] && [ "${DIGEST}" != "null" ]; then
      EXPECTED_HASH=$(echo "${DIGEST}" | cut -d':' -f2)
      ACTUAL_HASH=$(sha256sum "${BINARY_FILE}" | awk '{print $1}')
      if [ "${EXPECTED_HASH}" != "${ACTUAL_HASH}" ]; then
        echo "ERROR: SHA256 mismatch for Fabric binaries."
        echo "  Expected: ${EXPECTED_HASH}"
        echo "  Actual:   ${ACTUAL_HASH}"
        rm -f "${BINARY_FILE}"
        if [ -t 0 ]; then
          read -p "SHA256 mismatch detected. Would you like to retry the download? [y/N]: " retry_choice
          case "$retry_choice" in
            [yY]|[yY][eE][sS])
              echo "Retrying download..."
              continue
              ;;
          esac
        fi
        exit 1
      fi
      echo "==> SHA256 checksum verified."
    else
      echo "WARNING: Could not retrieve checksum from GitHub API (might be rate-limited or offline)."
      echo "         Skipping integrity verification."
    fi
    break
  done
  tar -C "${ROOTDIR}" -xzf "${BINARY_FILE}"
  rm "${BINARY_FILE}"
fi

if [ "${CRYPTO}" == "Fabric CA" ]; then
  NEED_CA=true
  if [ -f "${ROOTDIR}/bin/fabric-ca-client" ]; then
    CURRENT_CA_VER=$("${ROOTDIR}/bin/fabric-ca-client" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
    if [ "${CURRENT_CA_VER}" == "${CA_VERSION}" ]; then
      echo "==> Fabric CA binaries (v${CURRENT_CA_VER}) already exist. Skipping download."
      NEED_CA=false
    else
       echo "==> CA Version mismatch: found v${CURRENT_CA_VER}, need v${CA_VERSION}."
    fi
  fi

  if [ "$NEED_CA" == "true" ]; then
    CA_BINARY_FILE="${ROOTDIR}/hyperledger-fabric-ca-${PLATFORM}-${CA_VERSION}.tar.gz"
    CA_BINARY_URL="https://github.com/hyperledger/fabric-ca/releases/download/v${CA_VERSION}/hyperledger-fabric-ca-${PLATFORM}-${CA_VERSION}.tar.gz"
    while true; do
      download "Fabric CA Binaries" "${CA_BINARY_URL}" "${CA_BINARY_FILE}"
      echo "==> Verifying SHA256 checksum for Fabric CA binaries via GitHub Releases API..."
      DIGEST_CA=$(curl -sL "https://api.github.com/repos/hyperledger/fabric-ca/releases/tags/v${CA_VERSION}" \
        | jq -r --arg name "hyperledger-fabric-ca-${PLATFORM}-${CA_VERSION}.tar.gz" \
          '.assets[] | select(.name == $name) | .digest' 2>/dev/null || true)

      if [ -n "${DIGEST_CA}" ] && [ "${DIGEST_CA}" != "null" ]; then
        EXPECTED_HASH=$(echo "${DIGEST_CA}" | cut -d':' -f2)
        ACTUAL_HASH=$(sha256sum "${CA_BINARY_FILE}" | awk '{print $1}')
        if [ "${EXPECTED_HASH}" != "${ACTUAL_HASH}" ]; then
          echo "ERROR: SHA256 mismatch for Fabric CA binaries."
          echo "  Expected: ${EXPECTED_HASH}"
          echo "  Actual:   ${ACTUAL_HASH}"
          rm -f "${CA_BINARY_FILE}"
          if [ -t 0 ]; then
            read -p "SHA256 mismatch detected. Would you like to retry the download? [y/N]: " retry_choice
            case "$retry_choice" in
              [yY]|[yY][eE][sS])
                echo "Retrying download..."
                continue
                ;;
            esac
          fi
          exit 1
        fi
        echo "==> SHA256 checksum verified."
      else
        echo "WARNING: Could not retrieve CA checksum from GitHub API (might be rate-limited or offline)."
        echo "         Skipping integrity verification."
      fi
      break
    done
    tar -C "${ROOTDIR}" -xzf "${CA_BINARY_FILE}"
    rm "${CA_BINARY_FILE}"
  fi
fi

# 2. Pull Docker Images
FABRIC_REGISTRY=$(dockerFabricRegistry "${FABRIC_VERSION}")
CA_REGISTRY=$(dockerCARegistry "${CA_VERSION}")

echo "=== Pulling Fabric Docker Images from ${FABRIC_REGISTRY} ==="
for image in peer orderer ccenv baseos; do
  FULL_IMAGE="${FABRIC_REGISTRY}/fabric-${image}:${FABRIC_VERSION}"
  echo "==> Pulling ${FULL_IMAGE}..."
  "${CONTAINER_CLI}" pull "${FULL_IMAGE}" || { echo "ERROR: Failed to pull ${FULL_IMAGE}. Check registry connectivity and image tag."; exit 1; }
  "${CONTAINER_CLI}" tag "${FULL_IMAGE}" "hyperledger/fabric-${image}:${FABRIC_VERSION}"
  "${CONTAINER_CLI}" tag "${FULL_IMAGE}" "hyperledger/fabric-${image}"
done

if [ "${CRYPTO}" == "Fabric CA" ]; then
  echo "=== Pulling Fabric CA Image from ${CA_REGISTRY} ==="
  FULL_CA_IMAGE="${CA_REGISTRY}/fabric-ca:${CA_VERSION}"
  echo "==> Pulling ${FULL_CA_IMAGE}..."
  "${CONTAINER_CLI}" pull "${FULL_CA_IMAGE}" || { echo "ERROR: Failed to pull ${FULL_CA_IMAGE}."; exit 1; }
  "${CONTAINER_CLI}" tag "${FULL_CA_IMAGE}" "hyperledger/fabric-ca:${CA_VERSION}"
  "${CONTAINER_CLI}" tag "${FULL_CA_IMAGE}" "hyperledger/fabric-ca"
  
  if [ "${CA_DATABASE_TYPE}" == "postgres" ]; then
    echo "=== Pulling Postgres Image ==="
    echo "==> Pulling postgres:${POSTGRES_VERSION}..."
    "${CONTAINER_CLI}" pull "postgres:${POSTGRES_VERSION}" || { echo "ERROR: Failed to pull postgres:${POSTGRES_VERSION}."; exit 1; }
  fi
fi

{{- $anyCouch := false }}
{{- range $org := .Orgs }}
  {{- range $i := until .PeerCount }}
    {{- if eq ($org.PeerStateDatabase $i) "couchdb" }}
      {{- $anyCouch = true }}
    {{- end }}
  {{- end }}
{{- end }}

{{- if $anyCouch }}
if [ -n "${COUCHDB_VERSION}" ]; then
  echo "=== Pulling CouchDB Image ==="
  echo "==> Pulling couchdb:${COUCHDB_VERSION}..."
  "${CONTAINER_CLI}" pull "couchdb:${COUCHDB_VERSION}" || { echo "ERROR: Failed to pull couchdb:${COUCHDB_VERSION}."; exit 1; }
fi
{{- end }}

echo "=== Pulling Busybox for utility tasks ==="
"${CONTAINER_CLI}" pull busybox || { echo "ERROR: Failed to pull busybox."; exit 1; }

echo "=== Bootstrap Complete ==="
echo "Binaries are located in: ${ROOTDIR}/bin"
echo "Container images have been pulled."
