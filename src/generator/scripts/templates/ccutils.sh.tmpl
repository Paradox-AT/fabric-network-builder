#!/usr/bin/env bash
set -euo pipefail

DELAY=${DELAY:-3}
MAX_RETRY=${MAX_RETRY:-5}

# installChaincode ORG PEER
function installChaincode() {
  ORG=${1:-}
  PEER=${2:-0}
  setGlobals $ORG $PEER
  local ORG_NAME=$(getOrgName $ORG)
  task_start "Installing chaincode on ${ORG_NAME} peer${PEER}"
  if ! peer lifecycle chaincode queryinstalled --output json 2>/dev/null | jq -r 'try (.installed_chaincodes[].package_id)' | grep -q ^${PACKAGE_ID}$; then
    run_verbose peer lifecycle chaincode install ${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz || { task_fail; fatalln "Chaincode installation on ${ORG_NAME} peer${PEER} failed"; }
    task_done
  else
    task_done "already installed"
  fi
}

# queryInstalled PEER ORG
function queryInstalled() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  run_verbose peer lifecycle chaincode queryinstalled --output json
  verifyResult $? "Query installed on ${ORG_NAME} peer0 failed"
}

# approveForMyOrg VERSION PEER ORG
function approveForMyOrg() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  task_start "Approving chaincode definition for ${ORG_NAME} on channel '${CHANNEL_NAME}'"
  run_verbose peer lifecycle chaincode approveformyorg -o "${ORDERER_ADDRESS}" --tls --cafile "${ORDERER_CA}" --channelID "${CHANNEL_NAME}" --name "${CC_NAME}" --version "${CC_VERSION}" --package-id "${PACKAGE_ID}" --sequence "${CC_SEQUENCE}" ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} || { task_fail; fatalln "Chaincode definition approval on ${ORG_NAME} peer0 failed"; }
  task_done
}

# approveForMyOrgIfNeeded ORG — wraps approveForMyOrg with an idempotency check.
function approveForMyOrgIfNeeded() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  task_start "Approving chaincode definition for ${ORG_NAME} (seq ${CC_SEQUENCE})"

  set +e
  APPROVED=$(peer lifecycle chaincode queryapproved --channelID $CHANNEL_NAME --name ${CC_NAME} --output json 2>/dev/null \
    | jq -r --arg seq "${CC_SEQUENCE}" --arg ver "${CC_VERSION}" \
      'select(.sequence == ($seq|tonumber) and .version == $ver) | "approved"')
  set -e

  if [ "${APPROVED}" = "approved" ]; then
    task_done "already approved"
  else
    run_verbose peer lifecycle chaincode approveformyorg -o "${ORDERER_ADDRESS}" --tls --cafile "${ORDERER_CA}" --channelID "${CHANNEL_NAME}" --name "${CC_NAME}" --version "${CC_VERSION}" --package-id "${PACKAGE_ID}" --sequence "${CC_SEQUENCE}" ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} || { task_fail; fatalln "Chaincode definition approval on ${ORG_NAME} peer0 failed"; }
    task_done
  fi
}

# checkCommitReadiness VERSION PEER ORG
function checkCommitReadiness() {
  ORG=${1:-}
  shift 1
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  task_start "Checking commit readiness for ${ORG_NAME}"
  local rc=1
  local COUNTER=1
  local res=0
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
      if [ "${VERBOSE:-false}" = "true" ]; then
        stepln "Retrying commit readiness check for ${ORG_NAME} (attempt $COUNTER)"
      fi
    elif [ "${VERBOSE:-false}" = "true" ]; then
      println "${C_DIM}+ peer lifecycle chaincode checkcommitreadiness --channelID $CHANNEL_NAME --name ${CC_NAME} --version ${CC_VERSION} --sequence ${CC_SEQUENCE} ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} --output json${C_RESET}"
    fi
    set +e
    peer lifecycle chaincode checkcommitreadiness --channelID $CHANNEL_NAME --name ${CC_NAME} --version ${CC_VERSION} --sequence ${CC_SEQUENCE} ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} --output json >&log.txt 2>&1
    res=$?
    set -e
    rc=0
    for var in "$@"; do
      if ! grep "$var" log.txt &>/dev/null; then
        rc=1
      fi
    done
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ] || [ $res -ne 0 ]; then
    task_fail
    cat log.txt
    fatalln "After $MAX_RETRY attempts, commit readiness check for ${ORG_NAME} failed."
  fi
  if [ "${VERBOSE:-false}" = "true" ]; then
    cat log.txt
  fi
  task_done
}

# commitChaincodeDefinition VERSION PEER ORG (PEER ORG)
function commitChaincodeDefinition() {
  task_start "Committing chaincode definition to channel '${CHANNEL_NAME}'"
  parsePeerConnectionParameters $@
  res=$?
  [ $res -eq 0 ] || { task_fail; fatalln "Invoke transaction failed on channel '$CHANNEL_NAME' due to uneven peer and org parameters"; }

  run_verbose peer lifecycle chaincode commit -o "${ORDERER_ADDRESS}" --tls --cafile "${ORDERER_CA}" --channelID "${CHANNEL_NAME}" --name "${CC_NAME}" "${PEER_CONN_PARMS[@]}" --version "${CC_VERSION}" --sequence "${CC_SEQUENCE}" ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} || { task_fail; fatalln "Chaincode definition commit failed on channel '${CHANNEL_NAME}'"; }
  task_done
}

# queryCommitted ORG
function queryCommitted() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  local EXPECTED_RESULT="Version: ${CC_VERSION}, Sequence: ${CC_SEQUENCE}, Endorsement Plugin: escc, Validation Plugin: vscc"
  task_start "Verifying committed definition on ${ORG_NAME}"
  local rc=1
  local COUNTER=1
  local res=0
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
      if [ "${VERBOSE:-false}" = "true" ]; then
        stepln "Retrying query committed for ${ORG_NAME} (attempt $COUNTER)"
      fi
    elif [ "${VERBOSE:-false}" = "true" ]; then
      println "${C_DIM}+ peer lifecycle chaincode querycommitted --channelID $CHANNEL_NAME --name ${CC_NAME}${C_RESET}"
    fi
    set +e
    peer lifecycle chaincode querycommitted --channelID $CHANNEL_NAME --name ${CC_NAME} >&log.txt 2>&1
    res=$?
    set -e
    test $res -eq 0 && VALUE=$(cat log.txt | grep -o '^Version: '$CC_VERSION', Sequence: [0-9]*, Endorsement Plugin: escc, Validation Plugin: vscc')
    if test "$VALUE" = "$EXPECTED_RESULT"; then rc=0; fi
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ] || [ $res -ne 0 ]; then
    task_fail
    cat log.txt
    fatalln "After $MAX_RETRY attempts, chaincode definition query for ${ORG_NAME} failed."
  fi
  if [ "${VERBOSE:-false}" = "true" ]; then
    cat log.txt
  fi
  task_done
}

function chaincodeInvokeInit() {
  task_start "Executing initialization function '${CC_INIT_FCN}'"
  parsePeerConnectionParameters $@
  res=$?
  [ $res -eq 0 ] || { task_fail; fatalln "Invoke transaction failed on channel '$CHANNEL_NAME' due to uneven peer and org parameters"; }

  local rc=1
  local COUNTER=1
  local fcn_call='{"function":"'${CC_INIT_FCN}'","Args":[]}'
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    set +e
    run_verbose peer chaincode invoke -o localhost:{{ calculateOrdererPort 0 0 7050 }} --tls --cafile "$ORDERER_CA" -C $CHANNEL_NAME -n ${CC_NAME} "${PEER_CONN_PARMS[@]}" --isInit -c ${fcn_call}
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  [ $rc -eq 0 ] || { task_fail; fatalln "Chaincode initialization failed"; }
  task_done
}

function chaincodeQuery() {
  ORG=$1
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  task_start "Querying chaincode '${CC_NAME}' on peer0 of ${ORG_NAME}"
  local rc=1
  local COUNTER=1
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    set +e
    run_verbose peer chaincode query -C $CHANNEL_NAME -n ${CC_NAME} -c '{"Args":["org.hyperledger.fabric:GetMetadata"]}'
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    task_done
  else
    task_fail
    fatalln "After $MAX_RETRY attempts, Query on ${ORG_NAME} peer0 failed."
  fi
}

function resolveSequence() {
  if [[ "${CC_SEQUENCE}" != "auto" ]]; then
    return 0
  fi

  set +e
  COMMITTED_CC_SEQUENCE=$(peer lifecycle chaincode querycommitted \
    --channelID "$CHANNEL_NAME" --name "${CC_NAME}" 2>/dev/null \
    | sed -n '/Version:/{s/.*Sequence: //; s/, Endorsement Plugin:.*$//; p;}')
  set -e

  if [ -z "${COMMITTED_CC_SEQUENCE:-}" ]; then
    if [ "${VERBOSE:-false}" = "true" ]; then
      infoln "Chaincode '${CC_NAME}' has not been committed yet. Sequence resolved to: ${C_BOLD_WHITE}1${C_RESET}"
    fi
    CC_SEQUENCE=1
    return 0
  fi

  local rc=1
  local COUNTER=1
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    set +e
    APPROVED_CC_SEQUENCE=$(peer lifecycle chaincode queryapproved \
      --channelID "$CHANNEL_NAME" --name "${CC_NAME}" 2>/dev/null \
      | sed -n '/sequence:/{s/^sequence: //; s/, version:.*$//; p;}')
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done

  if [ "${COMMITTED_CC_SEQUENCE}" = "${APPROVED_CC_SEQUENCE:-}" ]; then
    CC_SEQUENCE=$((COMMITTED_CC_SEQUENCE + 1))
  else
    CC_SEQUENCE=${APPROVED_CC_SEQUENCE:-$((COMMITTED_CC_SEQUENCE + 1))}
  fi
  if [ "${VERBOSE:-false}" = "true" ]; then
    infoln "Sequence resolved to: ${C_BOLD_WHITE}${CC_SEQUENCE}${C_RESET}"
  fi
}

queryInstalledOnPeer() {
  local rc=1
  local COUNTER=1
  if [ "${VERBOSE:-false}" = "true" ]; then
    println "${C_DIM}+ peer lifecycle chaincode queryinstalled${C_RESET}"
  fi
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
    fi
    set +e
    peer lifecycle chaincode queryinstalled >&log.txt 2>&1
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  cat log.txt
}

queryCommittedOnChannel() {
  CHANNEL=$1
  local rc=1
  local COUNTER=1
  if [ "${VERBOSE:-false}" = "true" ]; then
    println "${C_DIM}+ peer lifecycle chaincode querycommitted -C $CHANNEL${C_RESET}"
  fi
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
    fi
    set +e
    peer lifecycle chaincode querycommitted -C $CHANNEL >&log.txt 2>&1
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  cat log.txt
  if test $rc -ne 0; then
    fatalln "After $MAX_RETRY attempts, failed to retrieve committed chaincode!"
  fi
}

listAllCommitted() {
  local rc=1
  local COUNTER=1
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
    fi
    set +e
    CHANNEL_LIST=$(peer channel list | sed '1,1d')
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    for channel in $CHANNEL_LIST
    do
      queryCommittedOnChannel "$channel"
    done
  else
    fatalln "After $MAX_RETRY attempts, failed to retrieve committed chaincode!"
  fi
}

chaincodeInvoke() {
  ORG=$1
  CHANNEL=$2
  CC_NAME=$3
  CC_INVOKE_CONSTRUCTOR=$4
  local ORG_NAME=$(getOrgName $ORG)

  task_start "Invoking chaincode '${CC_NAME}' on channel '${CHANNEL}'"
  local rc=1
  local COUNTER=1
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
      if [ "${VERBOSE:-false}" = "true" ]; then
        stepln "Retrying invoke on ${ORG_NAME} (attempt $COUNTER)"
      fi
    fi
    set +e
    run_verbose peer chaincode invoke -o localhost:{{ calculateOrdererPort 0 0 7050 }} -C $CHANNEL -n ${CC_NAME} -c ${CC_INVOKE_CONSTRUCTOR} --tls --cafile $ORDERER_CA "${PEER_CONN_PARMS[@]}"
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    task_done
  else
    task_fail
    fatalln "After $MAX_RETRY attempts, transaction invocation failed."
  fi
}

chaincodeQuery() {
  ORG=$1
  CHANNEL=$2
  CC_NAME=$3
  CC_QUERY_CONSTRUCTOR=$4
  local ORG_NAME=$(getOrgName $ORG)

  task_start "Querying chaincode '${CC_NAME}' on channel '${CHANNEL}'"
  local rc=1
  local COUNTER=1
  local query_output=""
  if [ "${VERBOSE:-false}" = "true" ]; then
    println "${C_DIM}+ peer chaincode query -C ${CHANNEL} -n ${CC_NAME} -c '${CC_QUERY_CONSTRUCTOR}'${C_RESET}"
  fi
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    if [ $COUNTER -gt 1 ]; then
      sleep $DELAY
      if [ "${VERBOSE:-false}" = "true" ]; then
        stepln "Retrying query on ${ORG_NAME} (attempt $COUNTER)"
      fi
    fi
    set +e
    query_output=$(peer chaincode query -C "$CHANNEL" -n "${CC_NAME}" -c "${CC_QUERY_CONSTRUCTOR}" 2>&1)
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    task_done
    if [ -n "${query_output}" ]; then
      println "${query_output}"
    fi
  else
    task_fail
    if [ -n "${query_output}" ]; then
      println "${query_output}"
    fi
    fatalln "After $MAX_RETRY attempts, query execution failed."
  fi
}
