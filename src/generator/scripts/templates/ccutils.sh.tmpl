#!/usr/bin/env bash
set -euo pipefail

# installChaincode PEER ORG
function installChaincode() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  if ! peer lifecycle chaincode queryinstalled --output json 2>/dev/null | jq -r 'try (.installed_chaincodes[].package_id)' | grep -q ^${PACKAGE_ID}$; then
    run_verbose peer lifecycle chaincode install ${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz
    verifyResult $? "Chaincode installation on ${ORG_NAME} peer0 has failed"
    successln "Chaincode is installed on ${ORG_NAME} peer0"
  else
    warnln "Chaincode '${CC_NAME}_${CC_VERSION}' is already installed on ${ORG_NAME} peer0. Skipping installation."
  fi
}

# queryInstalled PEER ORG
function queryInstalled() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  run_verbose peer lifecycle chaincode queryinstalled --output json
  verifyResult $? "Query installed on ${ORG_NAME} peer0 has failed"
}

# approveForMyOrg VERSION PEER ORG
function approveForMyOrg() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  run_verbose peer lifecycle chaincode approveformyorg -o localhost:{{ calculateOrdererPort 0 0 7050 }} --tls --cafile "$ORDERER_CA" --channelID $CHANNEL_NAME --name ${CC_NAME} --version ${CC_VERSION} --package-id ${PACKAGE_ID} --sequence ${CC_SEQUENCE} ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG}
  verifyResult $? "Chaincode definition approved on ${ORG_NAME} peer0 on channel '$CHANNEL_NAME' failed"
  successln "Chaincode definition approved on ${ORG_NAME} on channel '$CHANNEL_NAME'"
}

# approveForMyOrgIfNeeded ORG — wraps approveForMyOrg with an idempotency check.
# Queries the already-approved definition; if the sequence and version match, skips.
function approveForMyOrgIfNeeded() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  infoln "Checking if ${ORG_NAME} has already approved chaincode '${CC_NAME}' v${CC_VERSION} sequence ${CC_SEQUENCE}..."

  set +e
  APPROVED=$(peer lifecycle chaincode queryapproved --channelID $CHANNEL_NAME --name ${CC_NAME} --output json 2>/dev/null \
    | jq -r --arg seq "${CC_SEQUENCE}" --arg ver "${CC_VERSION}" \
      'select(.sequence == ($seq|tonumber) and .version == $ver) | "approved"')
  set -e

  if [ "${APPROVED}" = "approved" ]; then
    warnln "${ORG_NAME} has already approved '${CC_NAME}' v${CC_VERSION} sequence ${CC_SEQUENCE}. Skipping approval."
  else
    approveForMyOrg $ORG
  fi
}

# checkCommitReadiness VERSION PEER ORG
function checkCommitReadiness() {
  ORG=${1:-}
  shift 1
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  infoln "Checking the commit readiness of the chaincode definition for ${ORG_NAME} on channel '$CHANNEL_NAME'..."
  local rc=1
  local COUNTER=1
  local res=0
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    if [ $COUNTER -gt 1 ]; then
      infoln "Retrying commit readiness check for ${ORG_NAME} (attempt $COUNTER)..."
    fi
    set +e
    peer lifecycle chaincode checkcommitreadiness --channelID $CHANNEL_NAME --name ${CC_NAME} --version ${CC_VERSION} --sequence ${CC_SEQUENCE} ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG} --output json >&log.txt 2>&1
    res=$?
    set -e
    rc=0
    for var in "$@"; do
      if ! grep "$var" log.txt &>/dev/null; then
        rc=1
      fi
    done
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ] || [ $res -ne 0 ]; then
    cat log.txt
  fi
  if test $rc -eq 0; then
    successln "Commit readiness check passed for ${ORG_NAME} on channel '$CHANNEL_NAME'"
  else
    fatalln "After $MAX_RETRY attempts, commit readiness check for ${ORG_NAME} is INVALID!"
  fi
}

# commitChaincodeDefinition VERSION PEER ORG (PEER ORG)...
function commitChaincodeDefinition() {
  parsePeerConnectionParameters $@
  res=$?
  verifyResult $res "Invoke transaction failed on channel '$CHANNEL_NAME' due to uneven number of peer and org parameters "

  # while 'peer chaincode' command can get the orderer endpoint from the
  # peer (if join was successful), let's supply it directly as we know
  # it using the "-o" option
  run_verbose peer lifecycle chaincode commit -o localhost:{{ calculateOrdererPort 0 0 7050 }} --tls --cafile "$ORDERER_CA" --channelID $CHANNEL_NAME --name ${CC_NAME} "${PEER_CONN_PARMS[@]}" --version ${CC_VERSION} --sequence ${CC_SEQUENCE} ${INIT_REQUIRED} ${CC_END_POLICY} ${CC_COLL_CONFIG}
  verifyResult $? "Chaincode definition commit failed on peer0.org${ORG} on channel '$CHANNEL_NAME' failed"
  successln "Chaincode definition committed on channel '$CHANNEL_NAME'"
}

# queryCommitted ORG
function queryCommitted() {
  ORG=${1:-}
  setGlobals $ORG
  local ORG_NAME=$(getOrgName $ORG)
  EXPECTED_RESULT="Version: ${CC_VERSION}, Sequence: ${CC_SEQUENCE}, Endorsement Plugin: escc, Validation Plugin: vscc"
  infoln "Querying chaincode definition for ${ORG_NAME} on channel '$CHANNEL_NAME'..."
  local rc=1
  local COUNTER=1
  local res=0
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    if [ $COUNTER -gt 1 ]; then
      infoln "Retrying query committed for ${ORG_NAME} (attempt $COUNTER)..."
    fi
    set +e
    peer lifecycle chaincode querycommitted --channelID $CHANNEL_NAME --name ${CC_NAME} >&log.txt 2>&1
    res=$?
    set -e
    test $res -eq 0 && VALUE=$(cat log.txt | grep -o '^Version: '$CC_VERSION', Sequence: [0-9]*, Endorsement Plugin: escc, Validation Plugin: vscc')
    if test "$VALUE" = "$EXPECTED_RESULT"; then rc=0; fi
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ] || [ $res -ne 0 ]; then
    cat log.txt
  fi
  if test $rc -eq 0; then
    successln "Chaincode definition verified on ${ORG_NAME} on channel '$CHANNEL_NAME'"
  else
    fatalln "After $MAX_RETRY attempts, chaincode definition query for ${ORG_NAME} is INVALID!"
  fi
}

function chaincodeInvokeInit() {
  parsePeerConnectionParameters $@
  res=$?
  verifyResult $res "Invoke transaction failed on channel '$CHANNEL_NAME' due to uneven number of peer and org parameters "

  local rc=1
  local COUNTER=1
  local fcn_call='{"function":"'${CC_INIT_FCN}'","Args":[]}'
  # continue to poll
  # we either get a successful response, or reach MAX RETRY
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    infoln "invoke fcn call:${fcn_call}"
    run_verbose peer chaincode invoke -o localhost:{{ calculateOrdererPort 0 0 7050 }} --tls --cafile "$ORDERER_CA" -C $CHANNEL_NAME -n ${CC_NAME} "${PEER_CONN_PARMS[@]}" --isInit -c ${fcn_call}
    rc=$?
    COUNTER=$(expr $COUNTER + 1)
  done
  verifyResult $rc "Invoke execution on $PEERS failed "
  successln "Invoke transaction successful on $PEERS on channel '$CHANNEL_NAME'"
}

function chaincodeQuery() {
  ORG=$1
  setGlobals $ORG
  infoln "Querying on peer0.org${ORG} on channel '$CHANNEL_NAME'..."
  local rc=1
  local COUNTER=1
  # continue to poll
  # we either get a successful response, or reach MAX RETRY
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    sleep $DELAY
    infoln "Attempting to Query peer0.org${ORG}, Retry after $DELAY seconds."
    run_verbose peer chaincode query -C $CHANNEL_NAME -n ${CC_NAME} -c '{"Args":["org.hyperledger.fabric:GetMetadata"]}'
    rc=$?
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    successln "Query successful on peer0.org${ORG} on channel '$CHANNEL_NAME'"
  else
    fatalln "After $MAX_RETRY attempts, Query result on peer0.org${ORG} is INVALID!"
  fi
}

function resolveSequence() {

  #if the sequence is not "auto", then use the provided sequence
  if [[ "${CC_SEQUENCE}" != "auto" ]]; then
    return 0
  fi

  # Probe whether the chaincode is already committed on the channel.
  # A 404 / non-zero exit means it has never been committed — sequence starts at 1.
  set +e
  COMMITTED_CC_SEQUENCE=$(peer lifecycle chaincode querycommitted \
    --channelID "$CHANNEL_NAME" --name "${CC_NAME}" 2>/dev/null \
    | sed -n '/Version:/{s/.*Sequence: //; s/, Endorsement Plugin:.*$//; p;}')
  set -e

  if [ -z "${COMMITTED_CC_SEQUENCE:-}" ]; then
    infoln "Chaincode '${CC_NAME}' has not been committed yet. Setting sequence to 1."
    CC_SEQUENCE=1
    return 0
  fi

  # Chaincode already committed — find the approved (in-flight) sequence so we
  # know whether to re-use it or bump the committed one.
  local rc=1
  local COUNTER=1
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    set +e
    APPROVED_CC_SEQUENCE=$(peer lifecycle chaincode queryapproved \
      --channelID "$CHANNEL_NAME" --name "${CC_NAME}" 2>/dev/null \
      | sed -n '/sequence:/{s/^sequence: //; s/, version:.*$//; p;}')
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done

  # If committed and approved sequences match, bump by 1 for the new lifecycle round.
  if [ "${COMMITTED_CC_SEQUENCE}" = "${APPROVED_CC_SEQUENCE:-}" ]; then
    CC_SEQUENCE=$((COMMITTED_CC_SEQUENCE + 1))
  else
    CC_SEQUENCE=${APPROVED_CC_SEQUENCE:-$((COMMITTED_CC_SEQUENCE + 1))}
  fi

}

#. scripts/envVar.sh

queryInstalledOnPeer() {

  local rc=1
  local COUNTER=1
  # continue to poll
  # we either get a successful response, or reach MAX RETRY
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    set +e
    peer lifecycle chaincode queryinstalled >&log.txt 2>&1
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ]; then
    cat log.txt
  fi
}

queryCommittedOnChannel() {
  CHANNEL=$1
  local rc=1
  local COUNTER=1
  # continue to poll
  # we either get a successful response, or reach MAX RETRY
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    set +e
    peer lifecycle chaincode querycommitted -C $CHANNEL >&log.txt 2>&1
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if [ $rc -ne 0 ]; then
    cat log.txt
  fi
  if test $rc -ne 0; then
    fatalln "After $MAX_RETRY attempts, Failed to retrieve committed chaincode!"
  fi

}

## Function to list chaincodes installed on the peer and committed chaincode visible to the org
listAllCommitted() {

  local rc=1
  local COUNTER=1
  # continue to poll
  # we either get a successful response, or reach MAX RETRY
  while [ $rc -ne 0 -a $COUNTER -lt $MAX_RETRY ]; do
    set +e
    CHANNEL_LIST=$(peer channel list | sed '1,1d')
    rc=$?
    set -e
    COUNTER=$(expr $COUNTER + 1)
  done
  if test $rc -eq 0; then
    for channel in $CHANNEL_LIST
    do
      queryCommittedOnChannel "$channel"
    done
  else
    fatalln "After $MAX_RETRY attempts, Failed to retrieve committed chaincode!"
  fi

}

