#!/usr/bin/env bash
set -euo pipefail

# This script brings up a Hyperledger Fabric network generated by Network Builder

ROOTDIR=$(cd "$(dirname "$0")" && pwd)
export PATH="${ROOTDIR}/bin:${PATH}"
export VERBOSE=false
export PROMPT_ALWAYS=false

# Global verbose flag parsing: scan all arguments for -v or --verbose
for arg in "$@"; do
  if [ "$arg" = "-v" ] || [ "$arg" = "--verbose" ]; then
    export VERBOSE=true
  fi
done

# Strip -v / --verbose from positional arguments list
NEW_ARGS=()
for arg in "$@"; do
  if [ "$arg" != "-v" ] && [ "$arg" != "--verbose" ]; then
    NEW_ARGS+=("$arg")
  fi
done
if [ ${#NEW_ARGS[@]} -gt 0 ]; then
  set -- "${NEW_ARGS[@]}"
else
  set --
fi

. "${ROOTDIR}/network.config"
. "${ROOTDIR}/scripts/utils.sh"

# Source .env only once per shell session. The _FABRIC_ENV_LOADED guard prevents
# "readonly variable" errors when network.sh is re-invoked in the same shell or
# is sourced (. network.sh) rather than executed as a subprocess.
if [ -f "${ROOTDIR}/.env" ] && [ "${_FABRIC_ENV_LOADED:-0}" != "1" ]; then
  set -a
  . "${ROOTDIR}/.env"
  set +a
  _FABRIC_ENV_LOADED=1
fi

COMPOSE_FILE_BASE=${ROOTDIR}/compose/docker-compose.yaml
COMPOSE_FILE_CA=${ROOTDIR}/compose/compose-cas.yaml

# Export COMPOSE_PROJECT_NAME to scope all docker-compose operations
export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}

# Obtain CONTAINER_IDS and remove them
function clearContainers() {
  infoln "Removing remaining containers for project: ${COMPOSE_PROJECT_NAME}"
  docker rm -f $(docker ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}") 2>/dev/null || true
  infoln "Removing leftover chaincode containers"
  docker rm -f $(docker ps -aq --filter "label=org.hyperledger.fabric.chaincode.type") 2>/dev/null || true
}

# Delete chaincode docker images
function removeChaincodeImages() {
  infoln "Removing leftover chaincode images"
  docker rmi -f $(docker images -aq --filter "label=org.hyperledger.fabric.chaincode.type") 2>/dev/null || true
}

function bootstrap() {
  infoln "Initializing Fabric binaries and images"
  ${ROOTDIR}/scripts/bootstrap.sh
}

# Check if required binaries and config files exist, auto-bootstrap if missing
function checkBinaries() {
  local missing=false
  local BINS="peer orderer configtxgen cryptogen"
  if [ "${CRYPTO}" == "Fabric CA" ]; then
    BINS="${BINS} fabric-ca-client"
  fi

  for bin in ${BINS}; do
    if [ ! -f "${ROOTDIR}/bin/${bin}" ]; then
      warnln "Binary '${bin}' not found in ${ROOTDIR}/bin/"
      missing=true
    fi
  done

  # core.yaml is required by the peer binary (extracted from the Fabric tarball by bootstrap)
  if [ ! -f "${ROOTDIR}/config/core.yaml" ]; then
    warnln "config/core.yaml not found — Fabric config files are missing"
    missing=true
  fi

  # Check host system dependencies required at runtime
  local HOST_DEPS="docker jq curl tar"
  for dep in ${HOST_DEPS}; do
    if ! command -v "${dep}" > /dev/null 2>&1; then
      warnln "Required host tool '${dep}' not found. Install it and retry."
      missing=true
    fi
  done

  # Check if busybox image is available locally in Docker (used for file cleanup on network down)
  if command -v docker >/dev/null 2>&1; then
    if ! docker image inspect busybox >/dev/null 2>&1; then
      warnln "Docker image 'busybox' not found locally"
      missing=true
    fi
  fi

  if [ "$missing" = true ]; then
    if [ -t 0 ]; then
      read -p "One or more binaries or config files are missing. Would you like to run bootstrap to download them? [y/N]: " answer
      case "$answer" in
        [yY]|[yY][eE][sS])
          infoln "Running bootstrap..."
          bootstrap
          ;;
        *)
          fatalln "Aborting: Cannot start network without required binaries/configs."
          ;;
      esac
    else
      infoln "One or more binaries or config files are missing. Running bootstrap (non-interactive)..."
      bootstrap
    fi
  else
    # 2. Check for version mismatches
    local version_mismatch=false

    # Check Fabric version
    set +e
    CURRENT_VER=$("${ROOTDIR}/bin/peer" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
    set -e
    if [ "${CURRENT_VER}" != "${FABRIC_VERSION}" ]; then
      warnln "Fabric binary version mismatch: found v${CURRENT_VER}, expected v${FABRIC_VERSION}"
      version_mismatch=true
    fi

    # Check CA version if applicable
    if [ "${CRYPTO}" == "Fabric CA" ]; then
      set +e
      CURRENT_CA_VER=$("${ROOTDIR}/bin/fabric-ca-client" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
      set -e
      if [ "${CURRENT_CA_VER}" != "${CA_VERSION}" ]; then
        warnln "Fabric CA binary version mismatch: found v${CURRENT_CA_VER}, expected v${CA_VERSION}"
        version_mismatch=true
      fi
    fi

    if [ "$version_mismatch" = true ]; then
      warnln "It is highly recommended to run './network/network.sh bootstrap' to sync your binaries."
    else
      infoln "All required binaries and config files found (v${FABRIC_VERSION})."
    fi
  fi
}

function networkUp() {
  # 1. Pre-flight check: ensure binaries are present
  checkBinaries

  # 2. Generate crypto material if identities don't exist yet
  local missing_certs=false
  {{- range .Orgs }}
  if [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities" ]; then
    missing_certs=true
  fi
  {{- end }}

  if [ "$missing_certs" = true ]; then
    generateCerts
  fi

  if [ "${VERBOSE:-false}" = "true" ]; then
    docker_compose -f "${COMPOSE_FILE_BASE}" up -d
    docker ps -a
  else
    docker_compose -f "${COMPOSE_FILE_BASE}" up -d >&log.txt
    res=$?
    if [ $res -ne 0 ]; then
      cat log.txt
      fatalln "Unable to start network"
    fi
  fi
}

function generateCerts() {
  if [ "${CRYPTO}" == "Fabric CA" ]; then
    infoln "Generating certificates using Fabric CA"

    if [ "${VERBOSE:-false}" = "true" ]; then
      docker_compose -f "${COMPOSE_FILE_CA}" up -d
    else
      docker_compose -f "${COMPOSE_FILE_CA}" up -d >&log.txt
      res=$?
      if [ $res -ne 0 ]; then
        cat log.txt
        fatalln "Unable to start Fabric CA"
      fi
    fi

    {{- range $i, $org := .Orgs }}
    infoln "Waiting for {{ .Name }}'s CA to be ready..."

    # Pre-create directory for the certificate
    mkdir -p "${ROOTDIR}/organizations/{{ toLower .Name }}/ca"

    # Fetch the CA cert from the container. It might take a second to generate at first boot.
    COUNTER=0
    while [ $COUNTER -lt 10 ]; do
      docker cp ca.{{ .Domain }}:/etc/hyperledger/fabric-ca-server/ca-cert.pem "${ROOTDIR}/organizations/{{ toLower .Name }}/ca/ca-cert.pem" >/dev/null 2>&1 && break
      sleep 1
      COUNTER=$((COUNTER + 1))
    done

    # Wait for CA to accept requests (Application Layer Check)
    export FABRIC_CA_CLIENT_HOME="${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peerOrganizations/{{ .Domain }}"
    mkdir -p "${FABRIC_CA_CLIENT_HOME}"
    COUNTER=0
    rc=1
    {{- $orgUpper := toUpper .Name }}
    while [[ $rc -ne 0 && $COUNTER -lt 20 ]]; do
      sleep 1
      fabric-ca-client getcainfo -u https://${{ $orgUpper }}_CA_ADMIN_USER:${{ $orgUpper }}_CA_ADMIN_PASSWORD@localhost:{{ calculateCAPort $i 7054 }} --caname {{ .CAName }} --tls.certfiles "${ROOTDIR}/organizations/{{ toLower .Name }}/ca/ca-cert.pem" >/dev/null 2>&1
      rc=$?
      COUNTER=$((COUNTER + 1))
    done

    # Now that CA is ready, run the full enrollment script
    . "${ROOTDIR}/organizations/{{ toLower .Name }}/scripts/registerEnroll.sh"
    {{- end }}
  else
    which cryptogen >/dev/null 2>&1
    if [ "$?" -ne 0 ]; then
      fatalln "cryptogen tool not found. Run './network/network.sh bootstrap' first."
    fi

    infoln "Generating certificates using cryptogen tool"

    {{- range .Orgs }}
    infoln "Creating {{ .Name }} Identities"
    debug_on
    cryptogen generate --config=${ROOTDIR}/organizations/{{ toLower .Name }}/identity-config/cryptogen/crypto-config.yaml --output="${ROOTDIR}/organizations/{{ toLower .Name }}/identities"

    # Flatten the cryptogen output to match our Sovereign structure
    if [ -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peerOrganizations" ]; then
      mkdir -p ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer
      mv ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peerOrganizations/{{ .Domain }}/* ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/ 2>/dev/null || true
      rm -rf ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peerOrganizations
      # Standardize signcerts to cert.pem
      find ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
    fi
    if [ -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations" ]; then
      mkdir -p ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer
      mv ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations/{{ .Domain }}/* ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/ 2>/dev/null || true
      rm -rf ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations
      # Standardize signcerts to cert.pem
      find ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
    fi

    res=$?
    debug_off
    verifyResult $res "Failed to generate certificates for {{ .Name }}..."
    {{- end }}
  fi
}

function createChannel() {
  local auto_create=${1:-"false"}
  local skip_preflight=${2:-"false"}

  if [ "$skip_preflight" != "true" ]; then
    # Pre-flight 1: ensure all binaries are present
    checkBinaries

    # 1. Check if the network is running
    running=$(docker_compose -f "${COMPOSE_FILE_BASE}" ps --status running -q 2>/dev/null)
    if [ -z "$running" ]; then
      warnln "Network is not running."
      if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
        infoln "Starting network..."
        networkUp
      elif [ -t 0 ]; then
        read -p "Would you like to automatically spin up the network? [Yes/Always/No]: " answer
        answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
        case "$answer_lc" in
          always|a)
            PROMPT_ALWAYS=true
            infoln "Starting network (always=true)..."
            networkUp
            ;;
          yes|y)
            infoln "Starting network..."
            networkUp
            ;;
          *)
            fatalln "Network is required to create channel. Exiting."
            ;;
        esac
      else
        fatalln "Non-interactive environment detected and network is not running. Exiting."
      fi
    else
      infoln "Network is already up."
    fi

    # 2. Check if the channel already exists
    infoln "Checking if channel '${CHANNEL_NAME}' already exists..."
    channel_exists=false
    {{- $foundFirst := false }}
    {{- range $orgIndex, $org := .Orgs }}
      {{- if gt .OrdererCount 0 }}
        {{- $orgDomain := .Domain }}
        {{- $orgName := .Name }}
        {{- range $i, $e := until .OrdererCount }}
          {{- if not $foundFirst }}
            {{- $foundFirst = true }}
    OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
    export FABRIC_CFG_PATH="${ROOTDIR}/configtx"
    if osnadmin channel list \
      -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
      --ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
      --client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
      --client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
      2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
      channel_exists=true
    fi
    if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
      export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
    else
      unset FABRIC_CFG_PATH
    fi
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}

    if [ "$channel_exists" = true ]; then
      infoln "Channel '${CHANNEL_NAME}' already exists. Skipping channel creation."
      exit 0
    fi

    # 3. Prompt user if they want to create the channel since it does not exist
    if [ "$auto_create" = "true" ] || [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Proceeding to create channel '${CHANNEL_NAME}'..."
    elif [ -t 0 ]; then
      read -p "Channel '${CHANNEL_NAME}' does not exist. Would you like to create it? [yes,always,No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Proceeding to create channel '${CHANNEL_NAME}' (always=true)..."
          ;;
        yes|y)
          infoln "Proceeding to create channel '${CHANNEL_NAME}'..."
          ;;
        *)
          fatalln "Exiting without creating channel."
          ;;
      esac
    else
      infoln "Non-interactive environment detected. Proceeding to create channel '${CHANNEL_NAME}'..."
    fi
  fi

  ${ROOTDIR}/scripts/createChannel.sh "$CHANNEL_NAME" 3 5 false 0 "true" "true"
}

function networkDown() {
  infoln "Stopping network"
  if [ "${VERBOSE:-false}" = "true" ]; then
    docker_compose -f "${COMPOSE_FILE_BASE}" down --volumes --remove-orphans
    if [ "${CRYPTO}" == "Fabric CA" ]; then
      docker_compose -f "${COMPOSE_FILE_CA}" down --volumes --remove-orphans
    fi
  else
    docker_compose -f "${COMPOSE_FILE_BASE}" down --volumes --remove-orphans >/dev/null 2>&1
    if [ "${CRYPTO}" == "Fabric CA" ]; then
      docker_compose -f "${COMPOSE_FILE_CA}" down --volumes --remove-orphans >/dev/null 2>&1
    fi
  fi

  if [ "$MODE" != "restart" ]; then
    # Bring down the network, deleting the volumes
    clearContainers
    removeChaincodeImages

    infoln "Removing generated identities and artifacts"

    # Remove channel artifacts and logs
    rm -rf ${ROOTDIR}/channel-artifacts/* ${ROOTDIR}/log.txt

    # Remove organization identities and CA runtime data
    # We use a container to clean up to avoid permission issues with files created by Docker
    docker run --rm -v ${ROOTDIR}:/data busybox sh -c "
      cd /data && \
      {{- range .Orgs }}
      rm -rf organizations/{{ toLower .Name }}/identities && \
      rm -rf organizations/{{ toLower .Name }}/ca/msp \
             organizations/{{ toLower .Name }}/ca/tls-cert.pem \
             organizations/{{ toLower .Name }}/ca/ca-cert.pem \
             organizations/{{ toLower .Name }}/ca/IssuerPublicKey \
             organizations/{{ toLower .Name }}/ca/IssuerRevocationPublicKey \
             organizations/{{ toLower .Name }}/ca/fabric-ca-server.db && \
      {{- end }}
      true
    "
  fi
}

function deployCC() {
  # 1. Check if the network is running
  running=$(docker_compose -f "${COMPOSE_FILE_BASE}" ps --status running -q 2>/dev/null)
  if [ -z "$running" ]; then
    warnln "Network is not running."
    if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Starting network..."
      networkUp
    elif [ -t 0 ]; then
      read -p "Would you like to automatically spin up the network? [Yes/Always/No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Starting network (always=true)..."
          networkUp
          ;;
        yes|y)
          infoln "Starting network..."
          networkUp
          ;;
        *)
          fatalln "Network is required to deploy chaincode. Exiting."
          ;;
      esac
    else
      fatalln "Non-interactive environment detected and network is not running. Exiting."
    fi
  else
    infoln "Network is already up."
  fi

  # 2. Check if the channel exists
  infoln "Checking if channel '${CHANNEL_NAME}' exists..."
  channel_exists=false
  {{- $foundFirst := false }}
  {{- range $orgIndex, $org := .Orgs }}
    {{- if gt .OrdererCount 0 }}
      {{- $orgDomain := .Domain }}
      {{- $orgName := .Name }}
      {{- range $i, $e := until .OrdererCount }}
        {{- if not $foundFirst }}
          {{- $foundFirst = true }}
  OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
  export FABRIC_CFG_PATH="${ROOTDIR}/configtx"
  if osnadmin channel list \
    -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
    --ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
    --client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
    --client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
    2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
    channel_exists=true
  fi
  if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
    export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
  else
    unset FABRIC_CFG_PATH
  fi
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

  if [ "$channel_exists" = false ]; then
    warnln "Channel '${CHANNEL_NAME}' does not exist."
    if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Creating channel '${CHANNEL_NAME}'..."
      createChannel "true" "true"
    elif [ -t 0 ]; then
      read -p "Would you like to automatically create the channel '${CHANNEL_NAME}'? [Yes/Always/No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Creating channel '${CHANNEL_NAME}' (always=true)..."
          createChannel "true" "true"
          ;;
        yes|y)
          infoln "Creating channel '${CHANNEL_NAME}'..."
          createChannel "true" "true"
          ;;
        *)
          fatalln "Channel '${CHANNEL_NAME}' is required to deploy chaincode. Exiting."
          ;;
      esac
    else
      fatalln "Non-interactive environment detected and channel '${CHANNEL_NAME}' does not exist. Exiting."
    fi
  else
    infoln "Channel '${CHANNEL_NAME}' exists."
  fi

  # 3. Check if the chaincode is already deployed
  infoln "Checking if chaincode '${CC_NAME}' is already committed on channel '${CHANNEL_NAME}'..."

  # Source envVar.sh to set peer CLI variables for Org1 Peer0
  . ${ROOTDIR}/scripts/envVar.sh
  setGlobals 1 0

  OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
  export FABRIC_CFG_PATH="${ROOTDIR}/config"

  # Query committed definitions for the channel
  committed_info=$(peer lifecycle chaincode querycommitted -C "$CHANNEL_NAME" --name "$CC_NAME" 2>/dev/null || true)

  # Restore FABRIC_CFG_PATH before packaging/running scripts
  if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
    export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
  else
    unset FABRIC_CFG_PATH
  fi

  if [ -n "$committed_info" ]; then
    # Chaincode is already committed on the channel!
    committed_version=$(echo "$committed_info" | grep -i "Version:" | sed -e 's/.*Version: \([^,]*\).*/\1/')

    # Package the local chaincode to check version/hash
    infoln "Packaging chaincode to calculate package ID..."
    ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION

    # Calculate package ID and hash
    export FABRIC_CFG_PATH="${ROOTDIR}/config"
    LOCAL_PKG_ID=$(peer lifecycle chaincode calculatepackageid "${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz" 2>/dev/null || true)
    LOCAL_HASH=$(echo "$LOCAL_PKG_ID" | cut -d':' -f2)

    # Query the approved definition for this chaincode to get the deployed package hash
    approved_info=$(peer lifecycle chaincode queryapproved -C "$CHANNEL_NAME" --name "$CC_NAME" 2>/dev/null || true)
    approved_pkg_id=$(echo "$approved_info" | grep -i "package-id:" | sed -e 's/.*package-id: \([^,]*\).*/\1/')
    approved_hash=$(echo "$approved_pkg_id" | cut -d':' -f2)

    # Check if the same code hash is already deployed/approved
    if [ -n "$LOCAL_HASH" ] && [ "$LOCAL_HASH" = "$approved_hash" ]; then
      infoln "Chaincode '${CC_NAME}' with the same code hash ($LOCAL_HASH) is already deployed on channel '${CHANNEL_NAME}'. Skipping deployment."
      if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
        export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
      else
        unset FABRIC_CFG_PATH
      fi
      exit 0
    else
      # Code hash is different -> this is an upgrade!
      # Check if a chaincode with the same hash is already installed on the peer under a different name
      installed_list=$(peer lifecycle chaincode queryinstalled 2>/dev/null || true)
      if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
        export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
      else
        unset FABRIC_CFG_PATH
      fi

      if [ -n "$LOCAL_HASH" ]; then
        same_hash_cc=$(echo "$installed_list" | grep "$LOCAL_HASH" || true)
        if [ -n "$same_hash_cc" ]; then
          installed_label=$(echo "$same_hash_cc" | sed -n 's/.*Label: \([^,]*\).*/\1/p' | cut -d'_' -f1)
          if [ "$installed_label" != "$CC_NAME" ]; then
            warnln "A chaincode with the same hash ($LOCAL_HASH) is already installed on the peer under a different name: '$installed_label'."
          fi
        fi
      fi

      # Prompt user for upgrade
      if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
        infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'..."
      elif [ -t 0 ]; then
        read -p "Chaincode '${CC_NAME}' has changed (new hash: ${LOCAL_HASH}). Would you like to upgrade/re-deploy it? [yes,always,No]: " answer
        answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
        case "$answer_lc" in
          always|a)
            PROMPT_ALWAYS=true
            infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}' (always=true)..."
            ;;
          yes|y)
            infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'..."
            ;;
          *)
            fatalln "Exiting without upgrading chaincode."
            ;;
        esac
      else
        infoln "Non-interactive environment detected. Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'..."
      fi
    fi
  else
    # Chaincode with this name is not committed on the channel.
    # Package the local chaincode to check version/hash
    infoln "Packaging chaincode to calculate package ID..."
    ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION

    # Calculate package ID and hash
    export FABRIC_CFG_PATH="${ROOTDIR}/config"
    LOCAL_PKG_ID=$(peer lifecycle chaincode calculatepackageid "${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz" 2>/dev/null || true)
    LOCAL_HASH=$(echo "$LOCAL_PKG_ID" | cut -d':' -f2)

    # Check if a chaincode with the same hash is already installed on the peer under a different name
    installed_list=$(peer lifecycle chaincode queryinstalled 2>/dev/null || true)
    if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
      export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
    else
      unset FABRIC_CFG_PATH
    fi

    if [ -n "$LOCAL_HASH" ]; then
      same_hash_cc=$(echo "$installed_list" | grep "$LOCAL_HASH" || true)
      if [ -n "$same_hash_cc" ]; then
        installed_label=$(echo "$same_hash_cc" | sed -n 's/.*Label: \([^,]*\).*/\1/p' | cut -d'_' -f1)
        if [ "$installed_label" != "$CC_NAME" ]; then
          warnln "A chaincode with the same hash ($LOCAL_HASH) is already installed on the peer under a different name: '$installed_label'."
        fi
      fi
    fi

    # Prompt user for deployment
    if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Proceeding to deploy chaincode '${CC_NAME}'..."
    elif [ -t 0 ]; then
      read -p "Chaincode '${CC_NAME}' is not deployed on channel '${CHANNEL_NAME}'. Would you like to deploy it? [yes,always,No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Proceeding to deploy chaincode '${CC_NAME}' (always=true)..."
          ;;
        yes|y)
          infoln "Proceeding to deploy chaincode '${CC_NAME}'..."
          ;;
        *)
          fatalln "Exiting without deploying chaincode."
          ;;
      esac
    else
      infoln "Non-interactive environment detected. Proceeding to deploy chaincode '${CC_NAME}'..."
    fi
  fi

  scripts/deployCC.sh $CHANNEL_NAME $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION $CC_SEQUENCE $CC_INIT_FCN $CC_END_POLICY $CC_COLL_CONFIG 3 5 false "true" "true" "true"
  if [ $? -ne 0 ]; then
    fatalln "Deploying chaincode failed"
  fi
}

MODE=${1:-""}
if [ $# -gt 0 ]; then shift; fi

if [ "$MODE" == "up" ]; then
  networkUp
elif [ "$MODE" == "bootstrap" ]; then
  bootstrap
elif [ "$MODE" == "createChannel" ]; then
  CHANNEL_NAME=${1:-"mychannel"}
  createChannel
elif [ "$MODE" == "deployCC" ]; then
  CHANNEL_NAME="mychannel"
  CC_NAME="basic"
  CC_SRC_PATH="NA"
  CC_SRC_LANGUAGE="go"
  CC_VERSION="1.0"
  CC_SEQUENCE="auto"
  CC_INIT_FCN="NA"
  CC_END_POLICY="NA"
  CC_COLL_CONFIG="NA"

  while [[ $# -ge 1 ]] ; do
    key="$1"
    case $key in
    -c )
      CHANNEL_NAME="${2:-}"
      shift
      ;;
    -ccn )
      CC_NAME="${2:-}"
      shift
      ;;
    -ccp )
      CC_SRC_PATH="${2:-}"
      shift
      ;;
    -ccl )
      CC_SRC_LANGUAGE="${2:-}"
      shift
      ;;
    -ccv )
      CC_VERSION="${2:-}"
      shift
      ;;
    -ccs )
      CC_SEQUENCE="${2:-}"
      shift
      ;;
    -cci )
      CC_INIT_FCN="${2:-}"
      shift
      ;;
    -ccep )
      CC_END_POLICY="${2:-}"
      shift
      ;;
    -cccg )
      CC_COLL_CONFIG="${2:-}"
      shift
      ;;
    * )
      errorln "Unknown flag: $key"
      exit 1
      ;;
    esac
    shift
  done

  if [ "$CC_SRC_PATH" == "NA" ]; then
    fatalln "Please provide the chaincode source path using -ccp flag"
  fi
  deployCC
elif [ "$MODE" == "down" ]; then
  networkDown
else
  println "Usage: "
  println "  network.sh bootstrap"
  println "  network.sh up"
  println "  network.sh createChannel <channel_name>"
  println "  network.sh deployCC -ccn <name> -ccp <path> -ccl <language>"
  println "  network.sh down"
  exit 1
fi
