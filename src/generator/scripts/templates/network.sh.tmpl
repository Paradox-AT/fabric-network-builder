#!/usr/bin/env bash
set -euo pipefail

# This script brings up a Hyperledger Fabric network generated by Network Builder

ROOTDIR=$(cd "$(dirname "$0")" && pwd)
export PATH="${ROOTDIR}/bin:${PATH}"
export VERBOSE=false
export PROMPT_ALWAYS=false
export START_UTILITIES=false

# Global flag parsing: scan all arguments for verbose and utility options
for arg in "$@"; do
  if [ "$arg" = "-v" ] || [ "$arg" = "--verbose" ]; then
    export VERBOSE=true
  fi
  if [ "$arg" = "-u" ] || [ "$arg" = "--utility" ]; then
    export START_UTILITIES=true
  fi
done

# Strip parsed flags from positional arguments list
NEW_ARGS=()
for arg in "$@"; do
  if [ "$arg" != "-v" ] && [ "$arg" != "--verbose" ] && [ "$arg" != "-u" ] && [ "$arg" != "--utility" ]; then
    NEW_ARGS+=("$arg")
  fi
done
if [ ${#NEW_ARGS[@]} -gt 0 ]; then
  set -- "${NEW_ARGS[@]}"
else
  set --
fi

. "${ROOTDIR}/network.config"
. "${ROOTDIR}/scripts/utils.sh"
. "${ROOTDIR}/scripts/envVar.sh"

# Source .env only once per shell session. The _FABRIC_ENV_LOADED guard prevents
# "readonly variable" errors when network.sh is re-invoked in the same shell or
# is sourced (. network.sh) rather than executed as a subprocess.
if [ -f "${ROOTDIR}/.env" ] && [ "${_FABRIC_ENV_LOADED:-0}" != "1" ]; then
  set -a
  . "${ROOTDIR}/.env"
  set +a
  _FABRIC_ENV_LOADED=1
fi

COMPOSE_FILE_BASE=${ROOTDIR}/compose/docker-compose.yaml
COMPOSE_FILE_CA=${ROOTDIR}/compose/compose-cas.yaml
COMPOSE_FILE_UTILS=${ROOTDIR}/compose/compose-utils.yaml

# Export COMPOSE_PROJECT_NAME to scope all docker-compose operations
export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}

# Obtain CONTAINER_IDS and remove them
function clearContainers() {
  task_start "Removing leftover containers for project '${COMPOSE_PROJECT_NAME}'"
  local c_ids
  c_ids=$("${CONTAINER_CLI}" ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}" 2>/dev/null || true)
  if [ -n "$c_ids" ]; then
    "${CONTAINER_CLI}" rm -f $c_ids >/dev/null 2>&1 || true
  fi
  local cc_ids
  cc_ids=$("${CONTAINER_CLI}" ps -aq --filter "label=org.hyperledger.fabric.chaincode.type" 2>/dev/null || true)
  if [ -n "$cc_ids" ]; then
    "${CONTAINER_CLI}" rm -f $cc_ids >/dev/null 2>&1 || true
  fi
  task_done
}

# Delete chaincode docker images
function removeChaincodeImages() {
  task_start "Removing leftover chaincode Docker images"
  local img_ids
  img_ids=$("${CONTAINER_CLI}" images -aq --filter "label=org.hyperledger.fabric.chaincode.type" 2>/dev/null || true)
  if [ -n "$img_ids" ]; then
    "${CONTAINER_CLI}" rmi -f $img_ids >/dev/null 2>&1 || true
  fi
  task_done
}

function bootstrap() {
  headerln "Bootstrapping Fabric Binaries and Container Images"
  ${ROOTDIR}/scripts/bootstrap.sh
}

# Check if required binaries and config files exist, auto-bootstrap if missing
function checkBinaries() {
  local missing=false

  if [ "${VERBOSE:-false}" = "true" ]; then
    sectionln "Pre-Flight Dependency & Binary Check"
  fi

  local BINS="peer orderer configtxgen cryptogen"
  if [ "${CRYPTO}" == "Fabric CA" ]; then
    BINS="${BINS} fabric-ca-client"
  fi

  for bin in ${BINS}; do
    if [ ! -f "${ROOTDIR}/bin/${bin}" ]; then
      warnln "Binary '${bin}' not found in ${ROOTDIR}/bin/"
      missing=true
    elif [ "${VERBOSE:-false}" = "true" ]; then
      task_successln "Found binary: ${bin}"
    fi
  done

  # core.yaml is required by the peer binary (extracted from the Fabric tarball by bootstrap)
  if [ ! -f "${ROOTDIR}/config/core.yaml" ]; then
    warnln "config/core.yaml not found — Fabric config files are missing"
    missing=true
  elif [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Found config: config/core.yaml"
  fi

  # Check host system dependencies required at runtime
  local HOST_DEPS="${CONTAINER_CLI} jq curl tar"
  for dep in ${HOST_DEPS}; do
    if ! command -v "${dep}" > /dev/null 2>&1; then
      warnln "Required host tool '${dep}' not found. Install it and retry."
      missing=true
    fi
  done

  # Check if busybox image is available locally (used for file cleanup on network down)
  if command -v "${CONTAINER_CLI}" >/dev/null 2>&1; then
    if ! "${CONTAINER_CLI}" image inspect busybox >/dev/null 2>&1; then
      warnln "Container image 'busybox' not found locally"
      missing=true
    fi
  fi

  if [ "$missing" = true ]; then
    if [ -t 0 ]; then
      read -p "One or more binaries or config files are missing. Would you like to run bootstrap to download them? [y/N]: " answer
      case "$answer" in
        [yY]|[yY][eE][sS])
          infoln "Running bootstrap"
          bootstrap
          ;;
        *)
          fatalln "Aborting: Cannot start network without required binaries/configs."
          ;;
      esac
    else
      infoln "One or more binaries or config files are missing. Running bootstrap (non-interactive)"
      bootstrap
    fi
  else
    # Check for version mismatches
    local version_mismatch=false

    set +e
    CURRENT_VER=$("${ROOTDIR}/bin/peer" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
    set -e
    if [ "${CURRENT_VER}" != "${FABRIC_VERSION}" ]; then
      warnln "Fabric binary version mismatch: found v${CURRENT_VER}, expected v${FABRIC_VERSION}"
      version_mismatch=true
    fi

    if [ "${CRYPTO}" == "Fabric CA" ]; then
      set +e
      CURRENT_CA_VER=$("${ROOTDIR}/bin/fabric-ca-client" version | grep "Version:" | awk '{print $2}' | tr -d 'v')
      set -e
      if [ "${CURRENT_CA_VER}" != "${CA_VERSION}" ]; then
        warnln "Fabric CA binary version mismatch: found v${CURRENT_CA_VER}, expected v${CA_VERSION}"
        version_mismatch=true
      fi
    fi

    if [ "$version_mismatch" = true ]; then
      warnln "It is highly recommended to run './network.sh bootstrap' to sync your binaries."
    elif [ "${VERBOSE:-false}" = "true" ]; then
      successln "All required binaries and config files validated (Fabric v${FABRIC_VERSION})."
    fi
  fi
}

function networkUp() {
  headerln "Starting Hyperledger Fabric Network: ${NETWORK_NAME:-{{ .NetworkName }}}"

  # 1. Pre-flight check: ensure binaries are present
  checkBinaries

  # 2. Generate crypto material if identities don't exist yet
  local missing_certs=false
  {{- range .Orgs }}
  {{- if gt .PeerCount 0 }}
  if [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/msp" ]; then
    missing_certs=true
  fi
  {{- end }}
  {{- if gt .OrdererCount 0 }}
  if [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/msp" ]; then
    missing_certs=true
  fi
  {{- end }}
  {{- end }}

  if [ "$missing_certs" = "true" ]; then
    generateCerts
  fi

  sectionln "Deploying Network Infrastructure"
  if checkNetworkContainersUp quiet 2>/dev/null; then
    infoln "All peer and orderer containers are already up and running"
  else
    run_task "Starting peer and orderer containers" container_compose -f "${COMPOSE_FILE_BASE}" up -d
  fi

  # Start utility services (pgAdmin) if the config exists and -u/--utility is passed
  if [ -f "${COMPOSE_FILE_UTILS}" ] && [ "${START_UTILITIES}" = "true" ]; then
    run_task "Starting utility services (pgAdmin)" container_compose -f "${COMPOSE_FILE_UTILS}" up -d
  fi

  # Generate Connection Profiles (CCP) only if newly generated or missing
  if [ -f "${ROOTDIR}/organizations/ccp-generate.sh" ]; then
    local missing_ccp=false
    {{- range .Orgs }}
    {{- if gt .PeerCount 0 }}
    if [ ! -f "${ROOTDIR}/organizations/{{ toLower .Name }}/connection-{{ toLower .Name }}.json" ] || [ ! -f "${ROOTDIR}/organizations/{{ toLower .Name }}/connection-{{ toLower .Name }}.yaml" ]; then
      missing_ccp=true
    fi
    {{- end }}
    {{- end }}

    if [ "$missing_certs" = "true" ] || [ "$missing_ccp" = "true" ]; then
      sectionln "Generating Client Connection Profiles (CCP)"
      run_task "Generating Client Connection Profiles" "${ROOTDIR}/organizations/ccp-generate.sh"
    fi
  fi

  headerln "Hyperledger Fabric Network is UP and RUNNING!"
  println "  ${C_BOLD_WHITE}Network Name:${C_RESET} ${NETWORK_NAME:-{{ .NetworkName }}}"
  println "  ${C_BOLD_WHITE}Channel Name:${C_RESET} ${CHANNEL_NAME}"
  println "  ${C_BOLD_WHITE}Crypto Type:${C_RESET}  ${CRYPTO}"
  {{- range $i, $org := .Orgs }}
  println "  ${C_BOLD_GREEN}Org: {{ .Name }}${C_RESET} (${C_CYAN}{{ .Domain }}${C_RESET}) - MSP: ${C_BOLD_WHITE}{{ .MSPID }}${C_RESET}"
  {{- if gt .PeerCount 0 }}
  println "    Peers ({{ .PeerCount }}): {{ range $j, $p := until .PeerCount }}localhost:{{ calculatePeerPort $i $j 7051 }} {{ end }}"
  {{- end }}
  {{- if gt .OrdererCount 0 }}
  println "    Orderers ({{ .OrdererCount }}): {{ range $j, $o := until .OrdererCount }}localhost:{{ calculateOrdererPort $i $j 7050 }} {{ end }}"
  {{- end }}
  {{- end }}
  if [ "$MODE" == "up" ]; then
    println "\n${C_BOLD_CYAN}Next Steps:${C_RESET}"
    println "  1. Create channel and join peers:  ${C_BOLD_WHITE}./network.sh createChannel ${CHANNEL_NAME}${C_RESET}"
    println "  2. Deploy chaincode:               ${C_BOLD_WHITE}./network.sh deployCC -ccn <name> -ccp <path> -ccl <lang>${C_RESET}"
    println "  3. Bring down network:             ${C_BOLD_WHITE}./network.sh down${C_RESET}\n"
  fi
}

function generateCerts() {
  if [ "${CRYPTO}" == "Fabric CA" ]; then
    sectionln "Generating Certificates using Fabric CA"
    run_task "Starting Fabric CA containers" container_compose -f "${COMPOSE_FILE_CA}" up -d

    {{- range $i, $org := .Orgs }}
    if [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/msp" ] && [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/msp" ]; then
      task_start "Waiting for {{ .Name }}'s CA to be ready"

      # Pre-create directory for the certificate
      mkdir -p "${ROOTDIR}/organizations/{{ toLower .Name }}/ca"

      # Fetch the CA cert from the container. It might take a second to generate at first boot.
      COUNTER=0
      while [ $COUNTER -lt 10 ]; do
        "${CONTAINER_CLI}" cp ca.{{ .Domain }}:/etc/hyperledger/fabric-ca-server/ca-cert.pem "${ROOTDIR}/organizations/{{ toLower .Name }}/ca/ca-cert.pem" >/dev/null 2>&1 && break
        sleep 1
        COUNTER=$((COUNTER + 1))
      done

      # Wait for CA to accept requests (Application Layer Check)
      export FABRIC_CA_CLIENT_HOME="${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/{{ .Domain }}"
      mkdir -p "${FABRIC_CA_CLIENT_HOME}"
      COUNTER=0
      {{- $orgUpper := toUpper .Name }}
      while [ $COUNTER -lt 20 ]; do
        sleep 1
        if fabric-ca-client getcainfo -u https://${{ $orgUpper }}_CA_ADMIN_USER:${{ $orgUpper }}_CA_ADMIN_PASSWORD@localhost:{{ calculateCAPort $i 7054 }} --caname {{ .CAName }} --tls.certfiles "${ROOTDIR}/organizations/{{ toLower .Name }}/ca/ca-cert.pem" >/dev/null 2>&1; then
          break
        fi
        COUNTER=$((COUNTER + 1))
      done
      task_done

      # Now that CA is ready, run the full enrollment script
      . "${ROOTDIR}/organizations/{{ toLower .Name }}/scripts/registerEnroll.sh"
    else
      infoln "Crypto material already exists for {{ .Name }}. Skipping CA wait and enrollment."
    fi
    {{- end }}
  else
    which cryptogen >/dev/null 2>&1
    if [ "$?" -ne 0 ]; then
      fatalln "cryptogen tool not found. Run './network.sh bootstrap' first."
    fi

    sectionln "Generating Certificates using cryptogen"

    {{- range .Orgs }}
    if [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/msp" ] && [ ! -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/msp" ]; then
      task_start "Generating certificates for {{ .Name }} using cryptogen"
      run_verbose cryptogen generate --config=${ROOTDIR}/organizations/{{ toLower .Name }}/identity-config/cryptogen/crypto-config.yaml --output="${ROOTDIR}/organizations/{{ toLower .Name }}/identities" || { task_fail; fatalln "Failed to generate certificates for {{ .Name }}"; }

      # Flatten the cryptogen output to match our Sovereign structure
      if [ -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer" ]; then
        mkdir -p ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer
        mv ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/{{ .Domain }}/* ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/ 2>/dev/null || true
        rm -rf ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer
        # Standardize signcerts to cert.pem
        find ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/peer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
      fi
      if [ -d "${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations" ]; then
        mkdir -p ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer
        mv ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations/{{ .Domain }}/* ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/ 2>/dev/null || true
        rm -rf ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/ordererOrganizations
        # Standardize signcerts to cert.pem
        find ${ROOTDIR}/organizations/{{ toLower .Name }}/identities/orderer/ -name "*cert.pem" -exec sh -c 'mv "$1" "$(dirname "$1")/cert.pem"' _ {} \;
      fi

      task_done
    else
      infoln "Crypto material already exists for {{ .Name }}. Skipping cryptogen generation."
    fi
    {{- end }}
  fi
}

function createChannel() {
  local auto_create=${1:-"false"}
  local skip_preflight=${2:-"false"}

  if [ "$skip_preflight" != "true" ]; then
    # Pre-flight 1: ensure all binaries are present
    checkBinaries

    # 1. Check if all network containers are running
    if ! checkNetworkContainersUp 2>/dev/null; then
      warnln "Not all network containers are up and running."
      if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
        infoln "Starting network"
        networkUp
      elif [ -t 0 ]; then
        read -p "Would you like to automatically spin up the network? [Yes/Always/No]: " answer
        answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
        case "$answer_lc" in
          always|a)
            PROMPT_ALWAYS=true
            infoln "Starting network (always=true)"
            networkUp
            ;;
          yes|y)
            infoln "Starting network"
            networkUp
            ;;
          *)
            fatalln "All network containers are required to create channel. Exiting."
            ;;
        esac
      else
        fatalln "Non-interactive environment detected and not all network containers are running. Exiting."
      fi
    elif [ "${VERBOSE:-false}" = "true" ]; then
      task_successln "All peer and orderer containers are running"
    fi

    # 2. Check if the channel already exists
    if [ "${VERBOSE:-false}" = "true" ]; then
      stepln "Checking if channel '${CHANNEL_NAME}' already exists"
    fi
    channel_exists=false
    {{- $foundFirst := false }}
    {{- range $orgIndex, $org := .Orgs }}
      {{- if gt .OrdererCount 0 }}
        {{- $orgDomain := .Domain }}
        {{- $orgName := .Name }}
        {{- range $i, $e := until .OrdererCount }}
          {{- if not $foundFirst }}
            {{- $foundFirst = true }}
    OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
    export FABRIC_CFG_PATH="${ROOTDIR}/configtx"
    if osnadmin channel list \
      -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
      --ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
      --client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
      --client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
      2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
      channel_exists=true
    fi
    if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
      export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
    else
      unset FABRIC_CFG_PATH
    fi
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}

    if [ "$channel_exists" = true ]; then
      infoln "Channel '${CHANNEL_NAME}' already exists. Skipping channel creation."
      exit 0
    fi
  fi

  ${ROOTDIR}/scripts/createChannel.sh "$CHANNEL_NAME" 3 5 "${VERBOSE}" 0 "true" "true"

  if [ "$MODE" == "createChannel" ]; then
    println "\n${C_BOLD_CYAN}Next Steps:${C_RESET}"
    println "  1. Deploy a chaincode: ${C_BOLD_WHITE}./network.sh deployCC -c ${CHANNEL_NAME} -ccn <name> -ccp <path> -ccl <go|javascript|typescript|java>${C_RESET}"
    println "  2. Bring down network: ${C_BOLD_WHITE}./network.sh down${C_RESET}\n"
  fi
}

function networkDown() {
  headerln "Shutting Down Hyperledger Fabric Network"

  task_start "Stopping Docker containers"
  if [ "${VERBOSE:-false}" = "true" ]; then
    run_verbose container_compose -f "${COMPOSE_FILE_BASE}" down --volumes --remove-orphans
    if [ "${CRYPTO}" == "Fabric CA" ]; then
      run_verbose container_compose -f "${COMPOSE_FILE_CA}" down --volumes --remove-orphans
    fi
    if [ -f "${COMPOSE_FILE_UTILS}" ]; then
      run_verbose container_compose -f "${COMPOSE_FILE_UTILS}" down --volumes --remove-orphans
    fi
  else
    container_compose -f "${COMPOSE_FILE_BASE}" down --volumes --remove-orphans >/dev/null 2>&1
    if [ "${CRYPTO}" == "Fabric CA" ]; then
      container_compose -f "${COMPOSE_FILE_CA}" down --volumes --remove-orphans >/dev/null 2>&1
    fi
    if [ -f "${COMPOSE_FILE_UTILS}" ]; then
      container_compose -f "${COMPOSE_FILE_UTILS}" down --volumes --remove-orphans >/dev/null 2>&1
    fi
  fi
  task_done

  if [ "$MODE" != "restart" ]; then
    # Bring down the network, deleting the volumes
    clearContainers
    removeChaincodeImages

    task_start "Cleaning identities, certificates, and channel artifacts"

    # Remove channel artifacts and logs
    rm -rf ${ROOTDIR}/channel-artifacts/* ${ROOTDIR}/log.txt

    # Remove organization identities, CA runtime data, and connection profiles (CCP)
    # We use a container to clean up to avoid permission issues with files created by Docker
    "${CONTAINER_CLI}" run --rm -v ${ROOTDIR}:/data busybox sh -c "
      cd /data && \
      {{- range .Orgs }}
      rm -rf organizations/{{ toLower .Name }}/identities \
             organizations/{{ toLower .Name }}/connection-{{ toLower .Name }}.json \
             organizations/{{ toLower .Name }}/connection-{{ toLower .Name }}.yaml && \
      rm -rf organizations/{{ toLower .Name }}/ca/msp \
             organizations/{{ toLower .Name }}/ca/tls-cert.pem \
             organizations/{{ toLower .Name }}/ca/ca-cert.pem \
             organizations/{{ toLower .Name }}/ca/IssuerPublicKey \
             organizations/{{ toLower .Name }}/ca/IssuerRevocationPublicKey \
             organizations/{{ toLower .Name }}/ca/fabric-ca-server.db && \
      {{- end }}
      true
    " >/dev/null 2>&1 || true
    task_done
    successln "Hyperledger Fabric network shut down and cleaned successfully."
  fi
}

function deployCC() {
  headerln "Deploying Chaincode '${CC_NAME}' (v${CC_VERSION})"

  # 1. Check if all network containers are running
  if ! checkNetworkContainersUp 2>/dev/null; then
    warnln "Not all network containers are up and running."
    if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Starting network"
      networkUp
    elif [ -t 0 ]; then
      read -p "Would you like to automatically spin up the network? [Yes/Always/No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Starting network (always=true)"
          networkUp
          ;;
        yes|y)
          infoln "Starting network"
          networkUp
          ;;
        *)
          fatalln "All network containers are required to deploy chaincode. Exiting."
          ;;
      esac
    else
      fatalln "Non-interactive environment detected and not all network containers are running. Exiting."
    fi
  elif [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "All peer and orderer containers are running"
  fi

  # 2. Check if the channel exists
  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Checking if channel '${CHANNEL_NAME}' exists"
  fi
  channel_exists=false
  {{- $foundFirst := false }}
  {{- range $orgIndex, $org := .Orgs }}
    {{- if gt .OrdererCount 0 }}
      {{- $orgDomain := .Domain }}
      {{- $orgName := .Name }}
      {{- range $i, $e := until .OrdererCount }}
        {{- if not $foundFirst }}
          {{- $foundFirst = true }}
  OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
  export FABRIC_CFG_PATH="${ROOTDIR}/configtx"
  if osnadmin channel list \
    -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
    --ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
    --client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
    --client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
    2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
    channel_exists=true
  fi
  if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
    export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
  else
    unset FABRIC_CFG_PATH
  fi
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

  if [ "$channel_exists" = false ]; then
    warnln "Channel '${CHANNEL_NAME}' does not exist."
    if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
      infoln "Creating channel '${CHANNEL_NAME}'"
      createChannel "true" "true"
    elif [ -t 0 ]; then
      read -p "Would you like to automatically create the channel '${CHANNEL_NAME}'? [Yes/Always/No]: " answer
      answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
      case "$answer_lc" in
        always|a)
          PROMPT_ALWAYS=true
          infoln "Creating channel '${CHANNEL_NAME}' (always=true)"
          createChannel "true" "true"
          ;;
        yes|y)
          infoln "Creating channel '${CHANNEL_NAME}'"
          createChannel "true" "true"
          ;;
        *)
          fatalln "Channel '${CHANNEL_NAME}' is required to deploy chaincode. Exiting."
          ;;
      esac
    else
      fatalln "Non-interactive environment detected and channel '${CHANNEL_NAME}' does not exist. Exiting."
    fi
  elif [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "Channel '${CHANNEL_NAME}' exists"
  fi

  # 3. Check if the chaincode is already deployed
  if [ "${VERBOSE:-false}" = "true" ]; then
    stepln "Checking if chaincode '${CC_NAME}' is committed on channel '${CHANNEL_NAME}'"
  fi

  # Source envVar.sh to set peer CLI variables for Org1 Peer0
  . ${ROOTDIR}/scripts/envVar.sh
  setGlobals 1 0

  OLD_FABRIC_CFG_PATH=${FABRIC_CFG_PATH:-}
  export FABRIC_CFG_PATH="${ROOTDIR}/config"

  # Query committed definitions for the channel
  committed_info=$(peer lifecycle chaincode querycommitted -C "$CHANNEL_NAME" --name "$CC_NAME" 2>/dev/null || true)

  # Restore FABRIC_CFG_PATH before packaging/running scripts
  if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
    export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
  else
    unset FABRIC_CFG_PATH
  fi

  if [ -n "$committed_info" ]; then
    # Chaincode is already committed on the channel!
    committed_version=$(echo "$committed_info" | grep -i "Version:" | sed -e 's/.*Version: \([^,]*\).*/\1/')

    # Package the local chaincode to check version/hash quietly in pre-flight
    set +e
    if [ "${VERBOSE:-false}" = "true" ]; then
      ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION
    else
      ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION >&log.txt 2>&1
    fi
    set -e

    # Calculate package ID and hash
    export FABRIC_CFG_PATH="${ROOTDIR}/config"
    LOCAL_PKG_ID=$(peer lifecycle chaincode calculatepackageid "${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz" 2>/dev/null || true)
    LOCAL_HASH=$(echo "$LOCAL_PKG_ID" | cut -d':' -f2)

    # Query the approved definition for this chaincode to get the deployed package hash
    approved_info=$(peer lifecycle chaincode queryapproved -C "$CHANNEL_NAME" --name "$CC_NAME" 2>/dev/null || true)
    approved_pkg_id=$(echo "$approved_info" | grep -i "package-id:" | sed -e 's/.*package-id: \([^,]*\).*/\1/')
    approved_hash=$(echo "$approved_pkg_id" | cut -d':' -f2)

    # Check if the same code hash is already deployed/approved
    if [ -n "$LOCAL_HASH" ] && [ "$LOCAL_HASH" = "$approved_hash" ]; then
      infoln "Chaincode '${CC_NAME}' with the same code hash ($LOCAL_HASH) is already deployed on channel '${CHANNEL_NAME}'. Skipping deployment."
      if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
        export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
      else
        unset FABRIC_CFG_PATH
      fi
      exit 0
    else
      # Code hash is different -> this is an upgrade!
      # Check if a chaincode with the same hash is already installed on the peer under a different name
      installed_list=$(peer lifecycle chaincode queryinstalled 2>/dev/null || true)
      if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
        export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
      else
        unset FABRIC_CFG_PATH
      fi

      if [ -n "$LOCAL_HASH" ]; then
        same_hash_cc=$(echo "$installed_list" | grep "$LOCAL_HASH" || true)
        if [ -n "$same_hash_cc" ]; then
          installed_label=$(echo "$same_hash_cc" | sed -n 's/.*Label: \([^,]*\).*/\1/p' | cut -d'_' -f1)
          if [ "$installed_label" != "$CC_NAME" ]; then
            warnln "A chaincode with the same hash ($LOCAL_HASH) is already installed on the peer under a different name: '$installed_label'."
          fi
        fi
      fi

      # Prompt user for upgrade
      if [ "${PROMPT_ALWAYS:-false}" = "true" ]; then
        infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'"
      elif [ -t 0 ]; then
        read -p "Chaincode '${CC_NAME}' has changed (new hash: ${LOCAL_HASH}). Would you like to upgrade/re-deploy it? [yes,always,No]: " answer
        answer_lc=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
        case "$answer_lc" in
          always|a)
            PROMPT_ALWAYS=true
            infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}' (always=true)"
            ;;
          yes|y)
            infoln "Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'"
            ;;
          *)
            fatalln "Exiting without upgrading chaincode."
            ;;
        esac
      else
        infoln "Non-interactive environment detected. Proceeding to upgrade/re-deploy chaincode '${CC_NAME}'"
      fi
    fi
  else
    # Chaincode with this name is not committed on the channel.
    # Package the local chaincode to check version/hash quietly in pre-flight
    set +e
    if [ "${VERBOSE:-false}" = "true" ]; then
      ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION
    else
      ${ROOTDIR}/scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION >&log.txt 2>&1
    fi
    set -e

    # Calculate package ID and hash
    export FABRIC_CFG_PATH="${ROOTDIR}/config"
    LOCAL_PKG_ID=$(peer lifecycle chaincode calculatepackageid "${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz" 2>/dev/null || true)
    LOCAL_HASH=$(echo "$LOCAL_PKG_ID" | cut -d':' -f2)

    # Check if a chaincode with the same hash is already installed on the peer under a different name
    installed_list=$(peer lifecycle chaincode queryinstalled 2>/dev/null || true)
    if [ -n "${OLD_FABRIC_CFG_PATH}" ]; then
      export FABRIC_CFG_PATH="${OLD_FABRIC_CFG_PATH}"
    else
      unset FABRIC_CFG_PATH
    fi

    if [ -n "$LOCAL_HASH" ]; then
      same_hash_cc=$(echo "$installed_list" | grep "$LOCAL_HASH" || true)
      if [ -n "$same_hash_cc" ]; then
        installed_label=$(echo "$same_hash_cc" | sed -n 's/.*Label: \([^,]*\).*/\1/p' | cut -d'_' -f1)
        if [ "$installed_label" != "$CC_NAME" ]; then
          warnln "A chaincode with the same hash ($LOCAL_HASH) is already installed on the peer under a different name: '$installed_label'."
        fi
      fi
    fi
  fi

  export SKIP_HEADER=true
  scripts/deployCC.sh $CHANNEL_NAME $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION $CC_SEQUENCE $CC_INIT_FCN $CC_END_POLICY $CC_COLL_CONFIG 3 5 "${VERBOSE}" "true" "true" "true"
  if [ $? -ne 0 ]; then
    fatalln "Deploying chaincode failed"
  fi

  println "\n${C_BOLD_CYAN}Next Steps:${C_RESET}"
  println "  1. Invoke chaincode: ${C_BOLD_WHITE}./network.sh cc invoke -c ${CHANNEL_NAME} -ccn ${CC_NAME} -ccic '{\"Args\":[\"CreateAsset\",\"asset1\",\"blue\",\"5\",\"Tom\",\"35\"]}'${C_RESET}"
  println "  2. Query chaincode:  ${C_BOLD_WHITE}./network.sh cc query -c ${CHANNEL_NAME} -ccn ${CC_NAME} -ccqc '{\"Args\":[\"ReadAsset\",\"asset1\"]}'${C_RESET}"
  println "  3. List chaincodes:  ${C_BOLD_WHITE}./network.sh cc list -org 1${C_RESET}\n"
}

function listChaincode() {
  export FABRIC_CFG_PATH="${ROOTDIR}/config"
  . "${ROOTDIR}/scripts/envVar.sh"
  . "${ROOTDIR}/scripts/ccutils.sh"

  local org_idx=$(getOrgIndex "$ORG")
  if ! verifyPeerOrg "$org_idx"; then
    fatalln "Organization '$(getOrgName "$org_idx")' is not configured with peer nodes. This command requires a peer organization."
  fi
  setGlobals "$org_idx"

  headerln "Listing Chaincode on $(getOrgName "$org_idx")"
  println "${C_BOLD_CYAN}Installed chaincodes on peer0 of $(getOrgName "$org_idx"):${C_RESET}"
  queryInstalledOnPeer
  println
  println "${C_BOLD_CYAN}Committed chaincodes on channel '${CHANNEL_NAME}':${C_RESET}"
  listAllCommitted
}

function invokeChaincode() {
  export FABRIC_CFG_PATH="${ROOTDIR}/config"
  . "${ROOTDIR}/scripts/envVar.sh"
  . "${ROOTDIR}/scripts/ccutils.sh"

  local org_idx=$(getOrgIndex "$ORG")
  if ! verifyPeerOrg "$org_idx"; then
    fatalln "Organization '$(getOrgName "$org_idx")' is not configured with peer nodes. This command requires a peer organization."
  fi
  setGlobals "$org_idx"

  # Construct connection params for all orgs that have peers
  local orgs=()
  {{- range $i, $org := .Orgs }}
    {{- if gt .PeerCount 0 }}
  orgs+=("{{ inc $i }}")
    {{- end }}
  {{- end }}

  headerln "Invoking Chaincode '${CC_NAME}' on Channel '${CHANNEL_NAME}'"
  parsePeerConnectionParameters "${orgs[@]}"
  chaincodeInvoke "$org_idx" "$CHANNEL_NAME" "$CC_NAME" "$CC_INVOKE_CONSTRUCTOR"
}

function queryChaincode() {
  export FABRIC_CFG_PATH="${ROOTDIR}/config"
  . "${ROOTDIR}/scripts/envVar.sh"
  . "${ROOTDIR}/scripts/ccutils.sh"

  local org_idx=$(getOrgIndex "$ORG")
  if ! verifyPeerOrg "$org_idx"; then
    fatalln "Organization '$(getOrgName "$org_idx")' is not configured with peer nodes. This command requires a peer organization."
  fi
  setGlobals "$org_idx"

  headerln "Querying Chaincode '${CC_NAME}' on Channel '${CHANNEL_NAME}'"
  chaincodeQuery "$org_idx" "$CHANNEL_NAME" "$CC_NAME" "$CC_QUERY_CONSTRUCTOR"
}

function packageChaincode() {
  export FABRIC_CFG_PATH="${ROOTDIR}/config"
  . "${ROOTDIR}/scripts/envVar.sh"

  headerln "Packaging Chaincode '${CC_NAME}' (v${CC_VERSION})"
  ${ROOTDIR}/scripts/packageCC.sh "$CC_NAME" "$CC_SRC_PATH" "$CC_SRC_LANGUAGE" "$CC_VERSION" "true"
}

MODE=${1:-""}
if [ $# -gt 0 ]; then shift; fi

if [ "$MODE" == "up" ]; then
  networkUp
elif [ "$MODE" == "bootstrap" ]; then
  bootstrap
elif [ "$MODE" == "createChannel" ]; then
  CHANNEL_NAME=${1:-"${CHANNEL_NAME}"}
  createChannel
elif [ "$MODE" == "deployCC" ]; then
  CHANNEL_NAME="${CHANNEL_NAME}"
  CC_NAME="basic"
  CC_SRC_PATH="NA"
  CC_SRC_LANGUAGE="go"
  CC_VERSION="1.0"
  CC_SEQUENCE="auto"
  CC_INIT_FCN="NA"
  CC_END_POLICY="NA"
  CC_COLL_CONFIG="NA"

  while [[ $# -ge 1 ]] ; do
    key="$1"
    case $key in
    -c )
      CHANNEL_NAME="${2:-}"
      shift
      ;;
    -ccn )
      CC_NAME="${2:-}"
      shift
      ;;
    -ccp )
      CC_SRC_PATH="${2:-}"
      shift
      ;;
    -ccl )
      CC_SRC_LANGUAGE="${2:-}"
      shift
      ;;
    -ccv )
      CC_VERSION="${2:-}"
      shift
      ;;
    -ccs )
      CC_SEQUENCE="${2:-}"
      shift
      ;;
    -cci )
      CC_INIT_FCN="${2:-}"
      shift
      ;;
    -ccep )
      CC_END_POLICY="${2:-}"
      shift
      ;;
    -cccg )
      CC_COLL_CONFIG="${2:-}"
      shift
      ;;
    * )
      errorln "Unknown flag: $key"
      exit 1
      ;;
    esac
    shift
  done

  if [ "$CC_SRC_PATH" == "NA" ]; then
    fatalln "Please provide the chaincode source path using -ccp flag"
  fi
  deployCC
elif [ "$MODE" == "cc" ]; then
  SUBCOMMAND=${1:-""}
  if [ $# -gt 0 ]; then shift; fi

  if [ -z "$SUBCOMMAND" ]; then
    println "Usage: network.sh cc [package|list|invoke|query] [flags]"
    exit 1
  fi

  CHANNEL_NAME="${CHANNEL_NAME}"
  CC_NAME="basic"
  CC_SRC_PATH="NA"
  CC_SRC_LANGUAGE="go"
  CC_VERSION="1.0"
  CC_SEQUENCE="auto"
  CC_INIT_FCN="NA"
  CC_END_POLICY="NA"
  CC_COLL_CONFIG="NA"
  CC_INVOKE_CONSTRUCTOR=""
  CC_QUERY_CONSTRUCTOR=""
  ORG="1"

  while [[ $# -ge 1 ]] ; do
    key="$1"
    case $key in
    -c )
      CHANNEL_NAME="${2:-}"
      shift
      ;;
    -ccn )
      CC_NAME="${2:-}"
      shift
      ;;
    -ccp )
      CC_SRC_PATH="${2:-}"
      shift
      ;;
    -ccl )
      CC_SRC_LANGUAGE="${2:-}"
      shift
      ;;
    -ccv )
      CC_VERSION="${2:-}"
      shift
      ;;
    -ccs )
      CC_SEQUENCE="${2:-}"
      shift
      ;;
    -cci )
      CC_INIT_FCN="${2:-}"
      shift
      ;;
    -ccep )
      CC_END_POLICY="${2:-}"
      shift
      ;;
    -cccg )
      CC_COLL_CONFIG="${2:-}"
      shift
      ;;
    -ccic )
      CC_INVOKE_CONSTRUCTOR="${2:-}"
      shift
      ;;
    -ccqc )
      CC_QUERY_CONSTRUCTOR="${2:-}"
      shift
      ;;
    -org )
      ORG="${2:-}"
      shift
      ;;
    * )
      errorln "Unknown flag: $key"
      exit 1
      ;;
    esac
    shift
  done

  if [ "$SUBCOMMAND" == "list" ]; then
    listChaincode
  elif [ "$SUBCOMMAND" == "invoke" ]; then
    if [ -z "$CC_INVOKE_CONSTRUCTOR" ]; then
      fatalln "Please specify invoke constructor using -ccic flag"
    fi
    invokeChaincode
  elif [ "$SUBCOMMAND" == "query" ]; then
    if [ -z "$CC_QUERY_CONSTRUCTOR" ]; then
      fatalln "Please specify query constructor using -ccqc flag"
    fi
    queryChaincode
  elif [ "$SUBCOMMAND" == "package" ]; then
    if [ "$CC_SRC_PATH" == "NA" ]; then
      fatalln "Please provide the chaincode source path using -ccp flag"
    fi
    packageChaincode
  else
    println "Unknown cc subcommand: $SUBCOMMAND"
    exit 1
  fi
elif [ "$MODE" == "addOrg" ]; then
  ORG=""
  CHANNEL_NAME="${CHANNEL_NAME}"
  while [[ $# -ge 1 ]] ; do
    key="$1"
    case $key in
    -org )
      ORG="${2:-}"
      shift
      ;;
    -c )
      CHANNEL_NAME="${2:-}"
      shift
      ;;
    * )
      errorln "Unknown flag: $key"
      exit 1
      ;;
    esac
    shift
  done

  if [ -z "$ORG" ]; then
    fatalln "Please specify the organization to add using -org flag"
  fi

  ${ROOTDIR}/scripts/addOrg.sh "$ORG" "$CHANNEL_NAME"
elif [ "$MODE" == "monitoring" ]; then
  SUBCOMMAND=${1:-"up"}
  if [ "$SUBCOMMAND" == "up" ]; then
    headerln "Starting Monitoring Stack (Prometheus + Grafana)"
    ${CONTAINER_CLI_COMPOSE} -f ${ROOTDIR}/compose/compose-monitoring.yaml up -d
    successln "Monitoring stack is up and running."
    println "  Prometheus: ${C_BOLD_WHITE}http://localhost:9090${C_RESET}"
    println "  Grafana:    ${C_BOLD_WHITE}http://localhost:3000${C_RESET} (admin/adminpw)"
  elif [ "$SUBCOMMAND" == "down" ]; then
    headerln "Stopping Monitoring Stack"
    ${CONTAINER_CLI_COMPOSE} -f ${ROOTDIR}/compose/compose-monitoring.yaml down
    successln "Monitoring stack stopped."
  else
    errorln "Unknown monitoring subcommand: $SUBCOMMAND"
    exit 1
  fi
elif [ "$MODE" == "down" ]; then
  networkDown
elif [ "$MODE" == "-h" ] || [ "$MODE" == "--help" ] || [ -z "$MODE" ]; then
  println "${C_BOLD_CYAN}Hyperledger Fabric Network CLI${C_RESET}"
  println "Usage: "
  println "  ${C_BOLD_WHITE}./network.sh bootstrap${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh up [-v|--verbose] [-u|--utility]${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh createChannel [channel_name]${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh deployCC -ccn <name> -ccp <path> -ccl <language>${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh addOrg -org <OrgName> -c <ChannelName>${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh cc [package|list|invoke|query] [flags]${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh monitoring [up|down]${C_RESET}"
  println "  ${C_BOLD_WHITE}./network.sh down${C_RESET}"
  exit 0
else
  errorln "Unknown command: $MODE"
  println "Run './network.sh --help' for usage."
  exit 1
fi

