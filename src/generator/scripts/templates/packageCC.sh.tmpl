#!/usr/bin/env bash
set -euo pipefail

ROOTDIR=$(cd "$(dirname "$0")"/.. && pwd)
. "${ROOTDIR}/scripts/utils.sh"

CC_NAME=${1}
CC_SRC_PATH=${2}
CC_SRC_LANGUAGE=${3}
CC_VERSION=${4}

if [ "${VERBOSE:-false}" = "true" ]; then
  println "${C_BOLD_CYAN}Chaincode Packaging Parameters:${C_RESET}"
  println "  - CC_NAME:         ${C_GREEN}${CC_NAME}${C_RESET}"
  println "  - CC_SRC_PATH:     ${C_GREEN}${CC_SRC_PATH}${C_RESET}"
  println "  - CC_SRC_LANGUAGE: ${C_GREEN}${CC_SRC_LANGUAGE}${C_RESET}"
  println "  - CC_VERSION:      ${C_GREEN}${CC_VERSION}${C_RESET}"
fi

export FABRIC_CFG_PATH=${ROOTDIR}/config

# User has not provided a name
if [ -z "$CC_NAME" ] || [ "$CC_NAME" = "NA" ]; then
  fatalln "No chaincode name was provided. Example: ./network.sh cc package -ccn basic -ccp chaincode/asset-transfer-basic/chaincode-go -ccv 1.0 -ccl go"
elif [ -z "$CC_SRC_PATH" ] || [ "$CC_SRC_PATH" = "NA" ]; then
  fatalln "No chaincode path was provided. Example: ./network.sh cc package -ccn basic -ccp chaincode/asset-transfer-basic/chaincode-go -ccv 1.0 -ccl go"
elif [ -z "$CC_SRC_LANGUAGE" ] || [ "$CC_SRC_LANGUAGE" = "NA" ]; then
  fatalln "No chaincode language was provided. Example: ./network.sh cc package -ccn basic -ccp chaincode/asset-transfer-basic/chaincode-go -ccv 1.0 -ccl go"
elif [ ! -d "$CC_SRC_PATH" ]; then
  fatalln "Path to chaincode '${CC_SRC_PATH}' does not exist. Please provide a valid path."
fi

CC_SRC_LANGUAGE=$(echo "$CC_SRC_LANGUAGE" | tr [:upper:] [:lower:])

# Language-specific preparation
if [ "$CC_SRC_LANGUAGE" = "go" ]; then
  CC_RUNTIME_LANGUAGE=golang
  task_start "Vendoring Go dependencies at ${CC_SRC_PATH}"
  run_verbose bash -c "cd '$CC_SRC_PATH' && GO111MODULE=on go mod vendor" || { task_fail; fatalln "Go dependency vendoring failed"; }
  task_done

elif [ "$CC_SRC_LANGUAGE" = "java" ]; then
  CC_RUNTIME_LANGUAGE=java
  task_start "Compiling Java chaincode"
  run_verbose bash -c "cd '$CC_SRC_PATH' && ./gradlew installDist" || { task_fail; fatalln "Java compilation failed"; }
  task_done
  CC_SRC_PATH=$CC_SRC_PATH/build/install/$CC_NAME

elif [ "$CC_SRC_LANGUAGE" = "javascript" ]; then
  CC_RUNTIME_LANGUAGE=node

elif [ "$CC_SRC_LANGUAGE" = "typescript" ]; then
  CC_RUNTIME_LANGUAGE=node
  task_start "Compiling TypeScript chaincode"
  run_verbose bash -c "cd '$CC_SRC_PATH' && npm install && npm run build" || { task_fail; fatalln "TypeScript compilation failed"; }
  task_done

else
  fatalln "The chaincode language '${CC_SRC_LANGUAGE}' is not supported. Supported languages: go, java, javascript, typescript"
fi

packageChaincode() {
  local pkg_dir="${ROOTDIR}/channel-artifacts/packagedChaincode"
  local pkg_file="${pkg_dir}/${CC_NAME}_${CC_VERSION}.tar.gz"

  if [ ! -d "${pkg_dir}" ]; then
    mkdir -p "${pkg_dir}"
  fi

  task_start "Creating chaincode package archive: ${CC_NAME}_${CC_VERSION}.tar.gz"
  run_verbose peer lifecycle chaincode package "${pkg_file}" --path "${CC_SRC_PATH}" --lang "${CC_RUNTIME_LANGUAGE}" --label "${CC_NAME}_${CC_VERSION}" || { task_fail; fatalln "Chaincode packaging failed"; }
  task_done
  successln "Chaincode '${CC_NAME}' v${CC_VERSION} packaged successfully."
}

## package the chaincode
packageChaincode

exit 0
