#!/usr/bin/env bash
set -euo pipefail

ROOTDIR=$(cd "$(dirname "$0")"/../ && pwd)
. "${ROOTDIR}/scripts/envVar.sh"
. "${ROOTDIR}/network.config"

export FABRIC_CFG_PATH_ORDERER="${ROOTDIR}/configtx"
export FABRIC_CFG_PATH_PEER="${ROOTDIR}/config"

CHANNEL_NAME="${1:-${CHANNEL_NAME}}"
DELAY="${2:-3}"
MAX_RETRY="${3:-5}"
VERBOSE="${4:-false}"
BFT="${5:-0}"
SKIP_NET_CHECK="${6:-false}"
SKIP_CHANNEL_CHECK="${7:-false}"

if [ ! -d "${ROOTDIR}/channel-artifacts" ]; then
	mkdir -p "${ROOTDIR}/channel-artifacts"
fi

if [ "$SKIP_NET_CHECK" != "true" ]; then
	# 1. Check if the network is up and running
	if ! checkNetworkContainersUp 2>/dev/null; then
		fatalln "The Fabric network is not running or missing required containers. Please start the network first using './network.sh up'."
	elif [ "${VERBOSE:-false}" = "true" ]; then
		task_successln "All peer and orderer containers are running"
	fi
fi

if [ "$SKIP_CHANNEL_CHECK" != "true" ]; then
	# 2. Check if the channel already exists
	if [ "${VERBOSE:-false}" = "true" ]; then
		stepln "Checking if channel '${CHANNEL_NAME}' already exists"
	fi
	channel_exists=false
	{{- $foundFirst := false }}
	{{- range $orgIndex, $org := .Orgs }}
	  {{- if gt .OrdererCount 0 }}
	    {{- $orgDomain := .Domain }}
	    {{- $orgName := .Name }}
	    {{- range $i, $e := until .OrdererCount }}
	      {{- if not $foundFirst }}
	        {{- $foundFirst = true }}
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} osnadmin channel list \
		-o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
		--ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
		--client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
		--client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
		2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
		channel_exists=true
	fi
	      {{- end }}
	    {{- end }}
	  {{- end }}
	{{- end }}

	if [ "$channel_exists" = true ]; then
		infoln "Channel '${CHANNEL_NAME}' already exists. Skipping channel creation."
		exit 0
	fi
fi

if [ "${SKIP_HEADER:-false}" != "true" ]; then
	headerln "Creating Channel: ${CHANNEL_NAME}"
fi

createChannelGenesisBlock() {
	which configtxgen >/dev/null 2>&1 || fatalln "configtxgen tool not found."

	local block_file="${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block"
	if [ -f "${block_file}" ]; then
		if [ "${VERBOSE:-false}" = "true" ]; then
			task_warnln "Channel genesis block '${CHANNEL_NAME}.block' already exists. Skipping generation."
		else
			task_start "Generating channel genesis block '${CHANNEL_NAME}.block'"
			task_done "already exists"
		fi
		return 0
	fi

	task_start "Generating channel genesis block '${CHANNEL_NAME}.block'"
	FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} run_verbose configtxgen -profile ApplicationChannel -outputBlock "${block_file}" -channelID "${CHANNEL_NAME}" || { task_fail; fatalln "Failed to generate channel configuration transaction"; }
	task_done
}

createChannel() {
	local rc=1
	local COUNTER=1

	# We use osnadmin for modern channel creation/joining
{{- range $orgIndex, $org := .Orgs }}
  {{- if gt .OrdererCount 0 }}
    {{- $orgDomain := .Domain }}
    {{- $orgName := .Name }}
    {{- range $i, $e := until .OrdererCount }}
	task_start "Joining orderer{{$i}}.{{ $orgDomain }} to channel '${CHANNEL_NAME}'"
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} osnadmin channel list \
		-o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
		--ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
		--client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
		--client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
		2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
		task_done "already joined"
	else
		rc=1
		COUNTER=1
		while [ $rc -ne 0 ] && [ $COUNTER -lt $MAX_RETRY ] ; do
			if [ $COUNTER -gt 1 ]; then
				sleep $DELAY
				if [ "${VERBOSE:-false}" = "true" ]; then
					stepln "Retrying join for orderer{{$i}}.{{ $orgDomain }} (attempt $COUNTER)"
				fi
			fi
			set +e
			run_verbose osnadmin channel join --channelID ${CHANNEL_NAME} --config-block ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} --ca-file ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem --client-cert ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt --client-key ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key
			res=$?
			set -e
			rc=$res
			COUNTER=$(expr $COUNTER + 1)
		done
		[ $rc -eq 0 ] || { task_fail; fatalln "Orderer orderer{{$i}}.{{ $orgDomain }} failed to join channel '${CHANNEL_NAME}'"; }
		task_done
	fi
    {{- end }}
  {{- end }}
{{- end }}
}

joinChannel() {
  ORG=${1:-}
  PEER=${2:-}
  setGlobals $ORG $PEER
	local rc=1
	local COUNTER=1

	local ORG_NAME=$(getOrgName $ORG)
	task_start "Joining peer${PEER} of ${ORG_NAME} to channel '${CHANNEL_NAME}'"
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_PEER} peer channel list 2>/dev/null | grep -q "^${CHANNEL_NAME}$"; then
		task_done "already joined"
		return 0
	fi

	while [ $rc -ne 0 ] && [ $COUNTER -lt $MAX_RETRY ] ; do
		if [ $COUNTER -gt 1 ]; then
			sleep $DELAY
			if [ "${VERBOSE:-false}" = "true" ]; then
				stepln "Retrying join for peer${PEER} of ${ORG_NAME} (attempt $COUNTER)"
			fi
		fi
		set +e
		FABRIC_CFG_PATH=${FABRIC_CFG_PATH_PEER} run_verbose peer channel join -b ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block
		res=$?
		set -e
		rc=$res
		COUNTER=$(expr $COUNTER + 1)
	done
	[ $rc -eq 0 ] || { task_fail; fatalln "After $MAX_RETRY attempts, peer${PEER} of ${ORG_NAME} has failed to join channel '$CHANNEL_NAME'"; }
	task_done
}

## Main Channel Workflow
sectionln "Genesis Block Creation"
createChannelGenesisBlock

sectionln "Joining Orderers to Channel '${CHANNEL_NAME}'"
createChannel

sectionln "Joining Peers to Channel '${CHANNEL_NAME}'"
{{- range $i, $org := .Orgs }}
  {{- range $j, $p := until .PeerCount }}
joinChannel {{ inc $i }} {{ $j }}
  {{- end }}
{{- end }}

successln "Channel '${CHANNEL_NAME}' created and joined successfully."
