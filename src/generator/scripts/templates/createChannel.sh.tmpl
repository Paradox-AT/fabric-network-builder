#!/usr/bin/env bash
set -euo pipefail

ROOTDIR=$(cd "$(dirname "$0")"/../ && pwd)
. "${ROOTDIR}/scripts/envVar.sh"
. "${ROOTDIR}/network.config"

# FABRIC_CFG_PATH has two distinct values in this script:
#   - configtx/ for configtxgen + osnadmin (orderer admin tools)
#   - config/   for the peer CLI (needs core.yaml)
# Export both once here and reference them by name below.
export FABRIC_CFG_PATH_ORDERER="${ROOTDIR}/configtx"
export FABRIC_CFG_PATH_PEER="${ROOTDIR}/config"

CHANNEL_NAME="${1:-mychannel}"
DELAY="${2:-3}"
MAX_RETRY="${3:-5}"
VERBOSE="${4:-false}"
BFT="${5:-0}"
SKIP_NET_CHECK="${6:-false}"
SKIP_CHANNEL_CHECK="${7:-false}"

if [ ! -d "${ROOTDIR}/channel-artifacts" ]; then
	mkdir -p "${ROOTDIR}/channel-artifacts"
fi

if [ "$SKIP_NET_CHECK" != "true" ]; then
	# 1. Check if the network is up and running
	infoln "Checking if the network is up and running..."
	if [ -z "$(docker_compose -f ${ROOTDIR}/compose/docker-compose.yaml ps --status running -q 2>/dev/null)" ]; then
		fatalln "The Fabric network is not running. Please start the network first using './network.sh up'."
	fi
fi

if [ "$SKIP_CHANNEL_CHECK" != "true" ]; then
	# 2. Check if the channel already exists
	infoln "Checking if channel '${CHANNEL_NAME}' already exists..."
	channel_exists=false
	{{- $foundFirst := false }}
	{{- range $orgIndex, $org := .Orgs }}
	  {{- if gt .OrdererCount 0 }}
	    {{- $orgDomain := .Domain }}
	    {{- $orgName := .Name }}
	    {{- range $i, $e := until .OrdererCount }}
	      {{- if not $foundFirst }}
	        {{- $foundFirst = true }}
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} osnadmin channel list \
		-o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
		--ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
		--client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
		--client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
		2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
		channel_exists=true
	fi
	      {{- end }}
	    {{- end }}
	  {{- end }}
	{{- end }}

	if [ "$channel_exists" = true ]; then
		infoln "Channel '${CHANNEL_NAME}' already exists. Skipping channel creation."
		exit 0
	fi
fi

createChannelGenesisBlock() {
	which configtxgen >/dev/null 2>&1
	if [ "$?" -ne 0 ]; then
		fatalln "configtxgen tool not found."
	fi

	local block_file="${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block"
	if [ -f "${block_file}" ]; then
		warnln "Channel genesis block '${CHANNEL_NAME}.block' already exists. Skipping generation."
		return 0
	fi

	run_verbose bash -c "FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} configtxgen -profile ApplicationChannel -outputBlock '${block_file}' -channelID '${CHANNEL_NAME}'"
	res=$?
	verifyResult $res "Failed to generate channel configuration transaction..."
}

createChannel() {
	# Poll in case the raft leader is not set yet
	local rc=1
	local COUNTER=1
	infoln "Joining orderers to the channel"

	# We use osnadmin for modern channel creation/joining
{{- range $orgIndex, $org := .Orgs }}
  {{- if gt .OrdererCount 0 }}
    {{- $orgDomain := .Domain }}
    {{- $orgName := .Name }}
    {{- range $i, $e := until .OrdererCount }}
	infoln "Checking if orderer{{$i}}.{{ $orgDomain }} is already on channel '${CHANNEL_NAME}'..."
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} osnadmin channel list \
		-o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} \
		--ca-file "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem" \
		--client-cert "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt" \
		--client-key "${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key" \
		2>/dev/null | grep -q "\"${CHANNEL_NAME}\""; then
		warnln "Orderer orderer{{$i}}.{{ $orgDomain }} is already joined to '${CHANNEL_NAME}'. Skipping."
	else
		rc=1
		COUNTER=1
		infoln "Joining orderer{{$i}}.{{ $orgDomain }} to the channel..."
		while [ $rc -ne 0 ] && [ $COUNTER -lt $MAX_RETRY ] ; do
			sleep $DELAY
			run_verbose bash -c "FABRIC_CFG_PATH=${FABRIC_CFG_PATH_ORDERER} osnadmin channel join --channelID ${CHANNEL_NAME} --config-block ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block -o localhost:{{ calculateOrdererPort $orgIndex $i 7053 }} --ca-file ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/tlsca/tlsca.{{ $orgDomain }}-cert.pem --client-cert ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.crt --client-key ${ROOTDIR}/organizations/{{ toLower $orgName }}/identities/orderer/orderers/orderer{{$i}}.{{ $orgDomain }}/tls/server.key"
			res=$?
			rc=$res
			COUNTER=$(expr $COUNTER + 1)
		done
		verifyResult $res "Orderer orderer{{$i}}.{{ $orgDomain }} failed to join channel '${CHANNEL_NAME}'"
	fi
    {{- end }}
  {{- end }}
{{- end }}
}

# joinChannel ORG PEER
joinChannel() {
  ORG=${1:-}
  PEER=${2:-}
  setGlobals $ORG $PEER
	local rc=1
	local COUNTER=1

	local ORG_NAME=$(getOrgName $ORG)
	infoln "Checking if peer${PEER} of ${ORG_NAME} is already on channel '${CHANNEL_NAME}'..."
	if FABRIC_CFG_PATH=${FABRIC_CFG_PATH_PEER} peer channel list 2>/dev/null | grep -q "^${CHANNEL_NAME}$"; then
		warnln "Peer${PEER} of ${ORG_NAME} is already joined to '${CHANNEL_NAME}'. Skipping."
		return 0
	fi

	## Sometimes Join takes time, hence retry
	while [ $rc -ne 0 ] && [ $COUNTER -lt $MAX_RETRY ] ; do
    sleep $DELAY
    run_verbose bash -c "FABRIC_CFG_PATH=${FABRIC_CFG_PATH_PEER} peer channel join -b ${ROOTDIR}/channel-artifacts/${CHANNEL_NAME}.block"
    res=$?
		rc=$res
		COUNTER=$(expr $COUNTER + 1)
	done
	verifyResult $res "After $MAX_RETRY attempts, peer${PEER} of ${ORG_NAME} has failed to join channel '$CHANNEL_NAME' "
}

## Create channel genesis block
infoln "Generating channel genesis block '${CHANNEL_NAME}.block'"
createChannelGenesisBlock

## Create channel (Join orderers)
infoln "Creating channel ${CHANNEL_NAME}"
createChannel
successln "Channel '$CHANNEL_NAME' created"

## Join all the peers to the channel
{{- range $i, $org := .Orgs }}
  {{- range $j, $p := until .PeerCount }}
infoln "Joining {{ $org.Name }}'s peer{{ $j }} to the channel..."
joinChannel {{ inc $i }} {{ $j }}
  {{- end }}
{{- end }}

successln "Channel '$CHANNEL_NAME' joined"
