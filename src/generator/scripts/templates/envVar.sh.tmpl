#!/usr/bin/env bash
set -euo pipefail

# This is a collection of bash functions used by different scripts

TEST_NETWORK_HOME=${TEST_NETWORK_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)}
. ${TEST_NETWORK_HOME}/scripts/utils.sh

export CORE_PEER_TLS_ENABLED=true
if [ "${VERBOSE:-false}" = "true" ]; then
  export FABRIC_LOGGING_SPEC=${FABRIC_LOGGING_SPEC:-info}
else
  export FABRIC_LOGGING_SPEC=${FABRIC_LOGGING_SPEC:-error}
fi

# ORDERER_CA and ORDERER_ADDRESS are now set per-org inside setGlobals()
# so that every operation uses the correct orderer for the calling org.

# Set environment variables for the peer org
setGlobals() {
  local USING_ORG=""
  local USING_PEER=""
  if [ -z "${OVERRIDE_ORG:-}" ]; then
    USING_ORG=$1
  else
    USING_ORG="${OVERRIDE_ORG}"
  fi
  if [ -z "${2:-}" ]; then
    USING_PEER=0
  else
    USING_PEER=$2
  fi
  # Calculate peer address and credentials based on org + peer index
  {{- $firstOrg := true }}
{{- range $i, $org := .Orgs }}
  {{- if gt .PeerCount 0 }}
  {{ if $firstOrg }}if{{ else }}elif{{ end }} [ $USING_ORG -eq {{ inc $i }} ]; then
    export CORE_PEER_LOCALMSPID={{ .MSPID }}
    export CORE_PEER_TLS_ROOTCERT_FILE=${TEST_NETWORK_HOME}/organizations/{{ toLower .Name }}/identities/peer/tlsca/tlsca.{{ .Domain }}-cert.pem
    export CORE_PEER_MSPCONFIGPATH=${TEST_NETWORK_HOME}/organizations/{{ toLower .Name }}/identities/peer/users/Admin@{{ .Domain }}/msp
    # Calculate address based on peer index
    {{ range $j, $p := until .PeerCount }}
    if [ $USING_PEER -eq {{ $j }} ]; then
      export CORE_PEER_ADDRESS=localhost:{{ calculatePeerPort $i $j 7051 }}
    fi
    {{- end }}
    # Set orderer address and CA for this org's orderer
    {{- $hasOrderer := false }}
    {{- range $oi, $oorg := $.Orgs }}
      {{- if gt .OrdererCount 0 }}
        {{- if not $hasOrderer }}
    export ORDERER_ADDRESS=localhost:{{ calculateOrdererPort $oi 0 7050 }}
    export ORDERER_CA=${TEST_NETWORK_HOME}/organizations/{{ toLower .Name }}/identities/orderer/tlsca/tlsca.{{ .Domain }}-cert.pem
          {{- $hasOrderer = true }}
        {{- end }}
      {{- end }}
    {{- end }}
    {{- $firstOrg = false }}
  {{- end }}
{{- end }}
  {{- if $firstOrg }}
  if false; then
    :
  {{- end }}
  else
    errorln "ORG Unknown"
  fi

  if [ "$VERBOSE" = "true" ]; then
    env | grep CORE
  fi
}

# parsePeerConnectionParameters $@
# Helper function that sets the peer connection parameters for a chaincode
# operation
parsePeerConnectionParameters() {
  PEER_CONN_PARMS=()
  PEERS=""
  while [ "$#" -gt 0 ]; do
    setGlobals ${1:-}
    PEER="peer0.$(getOrgDomain ${1:-})"
    ## Set peer addresses
    if [ -z "$PEERS" ]
    then
	PEERS="$PEER"
    else
	PEERS="$PEERS $PEER"
    fi
    PEER_CONN_PARMS=("${PEER_CONN_PARMS[@]}" --peerAddresses $CORE_PEER_ADDRESS)
    ## Set path to TLS certificate
    # Note: This part needs careful mapping if org IDs are dynamic
    # For now assuming variables like ORG1_CA are set or can be derived
    CA_PATH=${TEST_NETWORK_HOME}/organizations/$(getOrgDir ${1:-})/identities/peer/tlsca/tlsca.$(getOrgDomain ${1:-})-cert.pem
    TLSINFO=(--tlsRootCertFiles "${CA_PATH}")
    PEER_CONN_PARMS=("${PEER_CONN_PARMS[@]}" "${TLSINFO[@]}")
    # shift by one to get to the next organization
    shift
  done
}

# Helper to resolve organization string to integer index
getOrgIndex() {
  local input="${1:-1}"
  # Check if numeric
  if [[ "$input" =~ ^[0-9]+$ ]]; then
    echo "$input"
    return
  fi
  local name=$(echo "$input" | tr '[:upper:]' '[:lower:]')
  {{- range $i, $org := .Orgs }}
  if [ "$name" = "{{ toLower .Name }}" ] || [ "$name" = "org{{ inc $i }}" ] || [ "$name" = "{{ toLower .Domain }}" ]; then
    echo "{{ inc $i }}"
    return
  fi
  {{- end }}
  echo "1"
}

# Returns the display name of the org (proper case, e.g. "Org1")
getOrgName() {
  {{- $firstOrg := true }}
{{- range $i, $org := .Orgs }}
  {{ if $firstOrg }}if{{ else }}elif{{ end }} [ ${1:-0} -eq {{ inc $i }} ]; then
    echo "{{ .Name }}"
    {{- $firstOrg = false }}
{{- end }}
  else
    fatalln "getOrgName: unknown org index '${1:-}'"
  fi
}

# Returns the lowercase directory name of the org (e.g. "org1") for filesystem paths
getOrgDir() {
  {{- $firstOrg := true }}
{{- range $i, $org := .Orgs }}
  {{ if $firstOrg }}if{{ else }}elif{{ end }} [ ${1:-0} -eq {{ inc $i }} ]; then
    echo "{{ toLower .Name }}"
    {{- $firstOrg = false }}
{{- end }}
  else
    fatalln "getOrgDir: unknown org index '${1:-}'"
  fi
}

getOrgDomain() {
  {{- $firstOrg := true }}
  {{- range $i, $org := .Orgs }}
  {{ if $firstOrg }}if{{ else }}elif{{ end }} [ ${1:-0} -eq {{ inc $i }} ]; then
    echo "{{ .Domain }}"
    {{- $firstOrg = false }}
  {{- end }}
  else
    fatalln "getOrgDomain: unknown org index '${1:-}'"
  fi
}

verifyPeerOrg() {
  local org_idx=$1
  {{- $firstOrg := true }}
  {{- range $i, $org := .Orgs }}
    {{- if gt .PeerCount 0 }}
  {{ if $firstOrg }}if{{ else }}elif{{ end }} [ $org_idx -eq {{ inc $i }} ]; then
    return 0
      {{- $firstOrg = false }}
    {{- end }}
  {{- end }}
  {{- if $firstOrg }}
  if false; then
    :
  {{- end }}
  else
    return 1
  fi
}

# verifyResult is exported by utils.sh — do not redefine it here.
