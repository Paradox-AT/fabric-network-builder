#!/usr/bin/env bash
set -euo pipefail

# Initialize colors using terminal capabilities if stdout is a TTY and supports color
if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  C_RESET="$(tput sgr0)"
  C_RED="$(tput setaf 1)"
  C_GREEN="$(tput setaf 2)"
  C_BLUE="$(tput setaf 4)"
  C_YELLOW="$(tput setaf 3)"
else
  C_RESET=""
  C_RED=""
  C_GREEN=""
  C_BLUE=""
  C_YELLOW=""
fi

function println() {
  echo -e "${1:-}"
}

function errorln() {
  println "${C_RED}${1:-}${C_RESET}"
}

function successln() {
  println "${C_GREEN}${1:-}${C_RESET}"
}

function infoln() {
  println "${C_BLUE}${1:-}${C_RESET}"
}

function warnln() {
  println "${C_YELLOW}${1:-}${C_RESET}"
}

function fatalln() {
  errorln "${1:-}"
  exit 1
}

function verifyResult() {
  if [ ${1:-0} -ne 0 ]; then
    fatalln "${2:-}"
  fi
}

export CONTAINER_CLI=${CONTAINER_CLI:-docker}
if command -v ${CONTAINER_CLI}-compose >/dev/null 2>&1; then
  export CONTAINER_CLI_COMPOSE="${CONTAINER_CLI}-compose"
else
  export CONTAINER_CLI_COMPOSE="${CONTAINER_CLI} compose"
fi

function container_compose() {
  ${CONTAINER_CLI_COMPOSE} "$@"
}
export -f container_compose

function debug_on() {
  if [ "${VERBOSE:-false}" = "true" ]; then
    set -x
  fi
}

function debug_off() {
  if [ "${VERBOSE:-false}" = "true" ]; then
    { set +x; } 2>/dev/null
  fi
}

function run_verbose() {
  local log_file="log.txt"
  if [ "${VERBOSE:-false}" = "true" ]; then
    set +e
    "$@" 2>&1 | tee "${log_file}"
    local res=${PIPESTATUS[0]}
    set -e
    return $res
  else
    set +e
    "$@" &>"${log_file}"
    local res=$?
    set -e
    if [ $res -ne 0 ]; then
      cat "${log_file}"
    fi
    return $res
  fi
}

# Error handler trap to print logs of the last command if it fails
function check_exit_status() {
  local exit_status=$?
  if [ $exit_status -ne 0 ]; then
    errorln "Script failed with status ${exit_status}."
    if [ -f "log.txt" ]; then
      errorln "Last log messages (log.txt):"
      cat "log.txt"
    elif [ -f "../log.txt" ]; then
      errorln "Last log messages (log.txt):"
      cat "../log.txt"
    fi
  fi
}
trap check_exit_status EXIT

export -f debug_on
export -f debug_off
export -f run_verbose

export -f errorln
export -f successln
export -f infoln
export -f warnln
export -f verifyResult
export -f fatalln
export -f println
