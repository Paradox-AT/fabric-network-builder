#!/usr/bin/env bash
set -euo pipefail

ROOTDIR=$(cd "$(dirname "$0")"/.. && pwd)
. "${ROOTDIR}/scripts/utils.sh"
. "${ROOTDIR}/network.config"

CHANNEL_NAME=${1:-"${CHANNEL_NAME}"}
CC_NAME=${2}
CC_SRC_PATH=${3}
CC_SRC_LANGUAGE=${4}
CC_VERSION=${5:-"1.0"}
CC_SEQUENCE=${6:-"1"}
CC_INIT_FCN=${7:-"NA"}
CC_END_POLICY=${8:-"NA"}
CC_COLL_CONFIG=${9:-"NA"}
DELAY=${10:-"3"}
MAX_RETRY=${11:-"5"}
VERBOSE=${12:-"false"}
SKIP_NET_CHECK=${13:-"false"}
SKIP_CHANNEL_CHECK=${14:-"false"}
SKIP_PACKAGING=${15:-"false"}

if [ "${VERBOSE:-false}" = "true" ]; then
  println "${C_BOLD_CYAN}Chaincode Deployment Parameters:${C_RESET}"
  println "  - CHANNEL_NAME:     ${C_GREEN}${CHANNEL_NAME}${C_RESET}"
  println "  - CC_NAME:          ${C_GREEN}${CC_NAME}${C_RESET}"
  println "  - CC_SRC_PATH:      ${C_GREEN}${CC_SRC_PATH}${C_RESET}"
  println "  - CC_SRC_LANGUAGE:  ${C_GREEN}${CC_SRC_LANGUAGE}${C_RESET}"
  println "  - CC_VERSION:       ${C_GREEN}${CC_VERSION}${C_RESET}"
  println "  - CC_SEQUENCE:      ${C_GREEN}${CC_SEQUENCE}${C_RESET}"
  println "  - CC_END_POLICY:    ${C_GREEN}${CC_END_POLICY}${C_RESET}"
  println "  - CC_COLL_CONFIG:   ${C_GREEN}${CC_COLL_CONFIG}${C_RESET}"
  println "  - CC_INIT_FCN:      ${C_GREEN}${CC_INIT_FCN}${C_RESET}"
  println "  - DELAY:            ${C_GREEN}${DELAY}${C_RESET}"
  println "  - MAX_RETRY:        ${C_GREEN}${MAX_RETRY}${C_RESET}"
fi

INIT_REQUIRED="--init-required"
if [ "$CC_INIT_FCN" = "NA" ]; then
  INIT_REQUIRED=""
fi

if [ "$CC_END_POLICY" = "NA" ]; then
  CC_END_POLICY=""
else
  CC_END_POLICY="--signature-policy $CC_END_POLICY"
fi

if [ "$CC_COLL_CONFIG" = "NA" ]; then
  CC_COLL_CONFIG=""
else
  CC_COLL_CONFIG="--collections-config $CC_COLL_CONFIG"
fi

export FABRIC_CFG_PATH=${ROOTDIR}/config

# import utils
. "${ROOTDIR}/scripts/envVar.sh"
. "${ROOTDIR}/scripts/ccutils.sh"

function checkPrereqs() {
  if ! command -v jq > /dev/null 2>&1; then
    fatalln "jq command not found. Please install jq to proceed."
  fi
}

if [ "$SKIP_PACKAGING" != "true" ]; then
  checkPrereqs
fi

if [ "$SKIP_NET_CHECK" != "true" ]; then
  if ! checkNetworkContainersUp "quiet" 2>/dev/null; then
    fatalln "The Fabric network is not running or missing required containers. Please start the network first using './network.sh up'."
  elif [ "${VERBOSE:-false}" = "true" ]; then
    task_successln "All peer and orderer containers are running"
  fi
fi

if [ "${SKIP_HEADER:-false}" != "true" ]; then
  headerln "Deploying Chaincode '${CC_NAME}' (v${CC_VERSION}) on Channel '${CHANNEL_NAME}'"
fi

# Verify if the channel exists on peer0 of Org1 before proceeding
if [ "$SKIP_CHANNEL_CHECK" != "true" ]; then
  setGlobals 1
  set +e
  CHANNEL_EXISTS=$(peer channel list 2>/dev/null | grep -x "${CHANNEL_NAME}")
  set -e

  if [ -z "${CHANNEL_EXISTS}" ]; then
    warnln "Channel '${CHANNEL_NAME}' does not exist on peer0.org1."
    if [ -t 0 ]; then
      read -p "Would you like to automatically create and join channel '${CHANNEL_NAME}'? [y/N]: " answer
      case "$answer" in
        [yY][eE][sS]|[yY])
          if ! checkNetworkContainersUp "quiet" 2>/dev/null; then
            warnln "Not all network containers are running. Starting network"
            ./network.sh up
          fi
          infoln "Creating channel '${CHANNEL_NAME}'"
          ./scripts/createChannel.sh "$CHANNEL_NAME" "$DELAY" "$MAX_RETRY" "$VERBOSE" 0 "true" "true"
          res=$?
          verifyResult $res "Channel creation/join failed"
          ;;
        *)
          fatalln "Channel '${CHANNEL_NAME}' is required to deploy chaincode. Exiting."
          ;;
      esac
    else
      fatalln "Non-interactive environment detected and channel '${CHANNEL_NAME}' does not exist. Exiting."
    fi
  fi
fi

if [ "$SKIP_PACKAGING" != "true" ]; then
  sectionln "Packaging Chaincode"
  ./scripts/packageCC.sh $CC_NAME $CC_SRC_PATH $CC_SRC_LANGUAGE $CC_VERSION
fi

if [ "${VERBOSE:-false}" = "true" ]; then
  println "${C_DIM}+ peer lifecycle chaincode calculatepackageid ${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz${C_RESET}"
fi
PACKAGE_ID=$(peer lifecycle chaincode calculatepackageid ${ROOTDIR}/channel-artifacts/packagedChaincode/${CC_NAME}_${CC_VERSION}.tar.gz)
if [ "${VERBOSE:-false}" = "true" ]; then
  infoln "Calculated Chaincode Package ID: ${C_BOLD_WHITE}${PACKAGE_ID}${C_RESET}"
fi

sectionln "1. Installing Chaincode on Peers"
{{- range $i, $org := .Orgs }}
  {{- range $j, $p := until .PeerCount }}
installChaincode {{ inc $i }} {{ $j }}
  {{- end }}
{{- end }}

resolveSequence

sectionln "2. Approving Chaincode Definition"
{{- range $i, $org := .Orgs }}
  {{- if gt .PeerCount 0 }}
approveForMyOrgIfNeeded {{ inc $i }}
  {{- end }}
{{- end }}

sectionln "3. Checking Commit Readiness"
{{- range $i, $org := .Orgs }}
  {{- if gt .PeerCount 0 }}
checkCommitReadiness {{ inc $i }}{{ range $j, $org2 := $.Orgs }}{{ if gt $org2.PeerCount 0 }} "\"{{ $org2.MSPID }}\": true"{{ end }}{{ end }}
  {{- end }}
{{- end }}

sectionln "4. Committing Chaincode Definition"
commitChaincodeDefinition{{ range $i, $org := .Orgs }}{{ if gt .PeerCount 0 }} {{ inc $i }}{{ end }}{{ end }}

sectionln "5. Verifying Committed Definition"
{{- range $i, $org := .Orgs }}
  {{- if gt .PeerCount 0 }}
queryCommitted {{ inc $i }}
  {{- end }}
{{- end }}

if [ "$CC_INIT_FCN" != "NA" ]; then
  sectionln "6. Initializing Chaincode"
  chaincodeInvokeInit{{ range $i, $org := .Orgs }}{{ if gt .PeerCount 0 }} {{ inc $i }}{{ end }}{{ end }}
fi

successln "Chaincode '${CC_NAME}' deployed successfully."
exit 0
